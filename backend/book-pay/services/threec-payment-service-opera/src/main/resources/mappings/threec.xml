<?xml version="1.0" encoding="UTF-8"?>
<mappings xmlns="http://dozermapper.github.io/schema/bean-mapping"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://dozermapper.github.io/schema/bean-mapping http://dozermapper.github.io/schema/bean-mapping.xsd">
    <mapping>
        <class-a>uk.co.whitbread.payments.model.PaymentRequest</class-a>
        <class-b>uk.co.whitbread.payments.model.threec.InitialiseRequest</class-b>
        <field>
            <a>payment.amount.currency</a>
            <b>trxAmountCurrencyCode</b>
        </field>
        <field>
            <a>payment.billing.address.line1</a>
            <b>cardholderAddressLine1</b>
        </field>
        <field>
            <a>payment.billing.address.line2</a>
            <b>cardholderAddressLine2</b>
        </field>
        <field>
            <a>payment.billing.address.line3</a>
            <b>cardholderAddressLine3</b>
        </field>
        <field>
            <a>payment.billing.address.line4</a>
            <b>cardholderAddressLine4</b>
        </field>
        <field>
            <a>payment.billing.address.countryCode</a>
            <b>cardholderAddressCountry</b>
        </field>
        <field>
            <a>payment.billing.address.postalCode</a>
            <b>cardholderAddressPostalCode</b>
        </field>
        <field>
            <a>payment.billing.firstName</a>
            <b>cardholderFirstName</b>
        </field>
        <field>
            <a>payment.billing.lastName</a>
            <b>cardholderLastName</b>
        </field>
        <field custom-converter="uk.co.whitbread.payments.converters.EmailConverter">
            <a>payment.billing.email</a>
            <b>cardholderEmail</b>
        </field>
        <field>
            <a>payment.billing.telephone</a>
            <b>cardholderTelephone</b>
        </field>
        <field>
            <a>payment.card.expiryMonth</a>
            <b>cardExpiryMonth</b>
        </field>
        <field>
            <a>payment.card.expiryYear</a>
            <b>cardExpiryYear</b>
        </field>
    </mapping>

    <mapping>
        <class-a>uk.co.whitbread.payments.model.PaymentRequest</class-a>
        <class-b>uk.co.whitbread.payments.model.threec.NoCardReadTransactionRequest</class-b>
        <field>
            <a>booking.channel</a>
            <b>request.params.bookingChannel</b>
        </field>
        <field>
            <a>payment.amount.currency</a>
            <b>request.params.currency</b>
        </field>
        <field>
            <a>payment.amount.minorUnits</a>
            <b>request.params.amount</b>
        </field>
        <field>
            <a>payment.billing.address.line1</a>
            <b>request.params.cardholderStreetAddress1</b>
        </field>
        <field>
            <a>payment.billing.address.line2</a>
            <b>request.params.cardholderStreetAddress2</b>
        </field>
        <field>
            <a>payment.billing.address.line3</a>
            <b>request.params.cardholderStreetAddress3</b>
        </field>
        <field>
            <a>payment.billing.address.line4</a>
            <b>request.params.cardholderStreetAddress4</b>
        </field>
        <field>
            <a>payment.billing.address.countryCode</a>
            <b>request.params.cardholderCountry</b>
        </field>
        <field>
            <a>payment.billing.address.postalCode</a>
            <b>request.params.cardholderZipCode</b>
        </field>
        <field>
            <a>payment.billing.firstName</a>
            <b>request.params.cardholderNameFirst</b>
        </field>
        <field>
            <a>payment.billing.lastName</a>
            <b>request.params.cardholderNameLast</b>
        </field>
        <field custom-converter="uk.co.whitbread.payments.converters.EmailConverter">
            <a>payment.billing.email</a>
            <b>request.params.cardholderEmail</b>
        </field>
        <field>
            <a>payment.billing.telephone</a>
            <b>request.params.cardholderTelephone</b>
        </field>
    </mapping>

    <mapping>
        <class-a>uk.co.whitbread.payments.model.PaymentRequest</class-a>
        <class-b>uk.co.whitbread.payments.model.eckoh.EckohWebPanelRequest</class-b>
        <field>
            <a>booking.businessSite.name</a>
            <b>hotelName</b>
        </field>
        <field>
            <a>booking.agent.email</a>
            <b>agentId</b>
        </field>
        <field custom-converter="uk.co.whitbread.payments.converters.TimeOfPayConverter">
            <a>booking.type</a>
            <b>timeOfPay</b>
        </field>
        <field custom-converter="uk.co.whitbread.payments.converters.PaymentMethodConverter">
            <a>payment.type</a>
            <b>paymentMethod</b>
        </field>
        <field custom-converter="uk.co.whitbread.payments.converters.CardAvailabilityConverter">
            <a>payment</a>
            <b>cardAvailability</b>
        </field>
        <field>
            <a>booking.businessSite.country</a>
            <b>hotelCountry</b>
        </field>
        <field>
            <a>booking.language</a>
            <b>language</b>
        </field>
    </mapping>
</mappings>