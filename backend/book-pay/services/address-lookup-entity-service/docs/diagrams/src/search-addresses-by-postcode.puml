@startuml
entity "Address Lookup Entity Service" as ALS
participant AddressLookupController as Controller
participant AddressLookupInPort as InboundPort
participant AddressLookupOutPort as OutboundPort
participant QASClient as WebClient
entity "Experian QAS" as QAS

ALS -> Controller: GET v1/addresses?searchTerm={{searchTerm}}
Controller -> InboundPort: getAddressesByPostCode
InboundPort -> OutboundPort: getAddressesByPostCode
OutboundPort -> WebClient: getAddressesByPostCode
WebClient -> QAS: POST {{host}}/ProOnDemand/V3/ProOnDemandService.asmx

WebClient <- QAS: QASearchResult
OutboundPort <- WebClient: List<AddressSearchResponse>
InboundPort <- OutboundPort: List<AddressSearchResponse>
Controller <- InboundPort: List<AddressSearchResponse>
ALS <- Controller: List<AddressSearchResponseDto>
@enduml

