<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>

    <!-- Test Plan -->
    <TestPlan guiclass="TestPlanGui"
              testclass="TestPlan"
              testname="Promo Batch Generation Test Plan"
              enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.comments"/>
    </TestPlan>

    <hashTree>

      <!-- Thread Group -->
      <ThreadGroup guiclass="ThreadGroupGui"
                   testclass="ThreadGroup"
                   testname="Promo Batch Users"
                   enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>

        <elementProp name="ThreadGroup.main_controller"
                     elementType="LoopController"
                     guiclass="LoopControlPanel"
                     testclass="LoopController"
                     testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>

        <intProp name="ThreadGroup.num_threads">10</intProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>

      <hashTree>

        <!-- CSV Data Set -->
        <CSVDataSet guiclass="TestBeanGUI"
                    testclass="CSVDataSet"
                    testname="Promo Batch CSV Data"
                    enabled="true">
          <stringProp name="filename">${__P(JMETER_BASE_DIR)}/data/promo_batch_data.csv</stringProp>
          <stringProp name="variableNames">batchCount,campaignName,codeLength,expiryDate,hotelId,notes,operaPromoCode,prefix,requestedBy</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
        </CSVDataSet>
        <hashTree/>

        <!-- HTTP Request -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui"
                          testclass="HTTPSamplerProxy"
                          testname="Generate Promo Batch"
                          enabled="true">

          <stringProp name="HTTPSampler.domain">${__P(BASE_HOST)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(BASE_PORT)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(BASE_PROTOCOL)}</stringProp>
          <stringProp name="HTTPSampler.path">${__P(BASE_PATH)}</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>

          <!-- Correctly using CSV variables in JSON body -->
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">
{
  "batchCount": ${batchCount},
  "campaignName": "${campaignName}",
  "codeLength": ${codeLength},
  "expiryDate": "${expiryDate}",
  "hotelId": "${hotelId}",
  "notes": "${notes}",
  "operaPromoCode": "${operaPromoCode}",
  "prefix": "${prefix}",
  "requestedBy": "${requestedBy}"
}
                </stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>

        </HTTPSamplerProxy>

        <hashTree>
          <!-- Header Manager -->
          <HeaderManager guiclass="HeaderPanel"
                         testclass="HeaderManager"
                         testname="HTTP Header Manager">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
        </hashTree>

      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
