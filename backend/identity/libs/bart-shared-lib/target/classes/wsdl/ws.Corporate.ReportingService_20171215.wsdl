<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:s0="http://corporate.micros.com/1.0" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             targetNamespace="http://corporate.micros.com/1.0">
    <types>
        <s:schema elementFormDefault="qualified" targetNamespace="http://corporate.micros.com/1.0">
			<s:complexType name="ClientHeader">
                <s:sequence>
                    <s:element name="languageCode" type="s:string" minOccurs="1" />
                    <s:element name="countryCode" type="s:string" minOccurs="1" />
                </s:sequence>
            </s:complexType>
            <s:complexType name="Login">
                <s:sequence>
                    <s:element name="username" type="s:string" minOccurs="1" />
                    <s:element name="password" type="s:string" minOccurs="1" />
                </s:sequence>
            </s:complexType>
            <s:complexType name="Source">
                <s:sequence>
                    <s:element name="bookingChannel" type="s:string" minOccurs="1" />
                </s:sequence>
            </s:complexType>            		
            <s:element name="EmergencyReport">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" name="request" type="s0:EmergencyReportRequest"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="EmergencyReportRequest">
                <s:sequence>
                    <s:element minOccurs="0" name="sessionID" type="s:string"/>
                    <s:element minOccurs="0" name="companyID" type="s:string"/>
                </s:sequence>
            </s:complexType>
            <s:element name="EmergencyReportResponse">
                <s:complexType>
                    <s:sequence>
                        <s:element name="EmergencyReportResult" type="s0:EmergencyReportResponse"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="EmergencyReportResponse">
                <s:sequence>
                    <s:element name="header" type="s:string"/>
                    <s:element name="data" type="s0:ExportData"/>
                    <s:element name="numberOfRecords" type="s:long"/>
                    <s:element name="endOfFile" type="s:boolean"/>
                    <s:element minOccurs="0" name="success" type="s:boolean"/>
                    <s:element minOccurs="0" name="errors" type="s0:ArrayOferrorError"/>
                </s:sequence>
            </s:complexType>
            <s:complexType name="ExportData">
                <s:sequence>
                    <s:element minOccurs="0" name="records" type="s0:ArrayOfrecordsItemString"/>
                </s:sequence>
            </s:complexType>
            <s:complexType name="ArrayOfrecordsItemString">
                <s:sequence>
                    <s:element maxOccurs="unbounded" minOccurs="0" name="recordsItem" nillable="true">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:maxLength value="500"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:element>
                </s:sequence>
            </s:complexType>
            <s:complexType name="ArrayOferrorError">
                <s:sequence>
                    <s:element maxOccurs="unbounded" minOccurs="0" name="error" nillable="true" type="s0:Error"/>
                </s:sequence>
            </s:complexType>
            <s:complexType name="Error">
                <s:sequence>
                    <s:element minOccurs="0" name="errorCode">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:maxLength value="5"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:element>
                    <s:element minOccurs="0" name="errorDescription" type="s:string"/>
                </s:sequence>
            </s:complexType>
            <s:element name="ManagementInformationReport">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" name="request" type="s0:ManagementInformationRequest"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="ManagementInformationRequest">
                <s:sequence>
                    <s:element minOccurs="0" name="sessionID" type="s:string"/>
                    <s:element minOccurs="0" name="companyID" type="s:string"/>
                    <s:element name="fromDate" type="s:date"/>
                    <s:element name="toDate" type="s:date"/>
                    <s:element minOccurs="0" name="reportItems" type="s0:ArrayOfreportItemsItemString"/>
                </s:sequence>
            </s:complexType>
            <s:complexType name="ArrayOfreportItemsItemString">
                <s:sequence>
                    <s:element maxOccurs="unbounded" minOccurs="0" name="reportItemsItem" nillable="true" type="s:string"/>
                </s:sequence>
            </s:complexType>
            <s:element name="ManagementInformationReportResponse">
                <s:complexType>
                    <s:sequence>
                        <s:element name="ManagementInformationReportResult" type="s0:ManagementInformationResponse"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="ManagementInformationResponse">
                <s:sequence>
                    <s:element name="header" type="s:string"/>
                    <s:element name="data" type="s0:ExportData"/>
                    <s:element name="numberOfRecords" type="s:long"/>
                    <s:element name="endOfFile" type="s:boolean"/>
                    <s:element minOccurs="0" name="success" type="s:boolean"/>
                    <s:element minOccurs="0" name="errors" type="s0:ArrayOferrorError"/>
                </s:sequence>
            </s:complexType>
            <s:element name="OutOfPolicyReport">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" name="request" type="s0:OutOfPolicyRequest"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="OutOfPolicyRequest">
                <s:sequence>
                    <s:element minOccurs="0" name="sessionID" type="s:string"/>
                    <s:element minOccurs="0" name="companyID" type="s:string"/>
                    <s:element minOccurs="0" name="fromDate" type="s:date"/>
                    <s:element minOccurs="0" name="toDate" type="s:date"/>
                </s:sequence>
            </s:complexType>
            <s:element name="OutOfPolicyReportResponse">
                <s:complexType>
                    <s:sequence>
                        <s:element name="OutOfPolicyReportResult" type="s0:OutOfPolicyResponse"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="OutOfPolicyResponse">
                <s:sequence>
                    <s:element name="header" type="s:string"/>
                    <s:element name="data" type="s0:ExportData"/>
                    <s:element name="numberOfRecords" type="s:long"/>
                    <s:element name="endOfFile" type="s:boolean"/>
                    <s:element minOccurs="0" name="success" type="s:boolean"/>
                    <s:element minOccurs="0" name="errors" type="s0:ArrayOferrorError"/>
                </s:sequence>
            </s:complexType>
        </s:schema>
    </types>
	<message name="AuthorizationRequestSoapIn">
        <part name="ClientHeader" type="s0:ClientHeader"/>
        <part name="Login" type="s0:Login"/>
    </message>
    <message name="SourceRequestSoapIn">
        <part name="Source" type="s0:Source"/>
    </message>
    <message name="EmergencyReportSoapIn">
        <part name="parameters" element="s0:EmergencyReport"/>
    </message>
    <message name="EmergencyReportSoapOut">
        <part name="parameters" element="s0:EmergencyReportResponse"/>
    </message>
    <message name="ManagementInformationReportSoapIn">
        <part name="parameters" element="s0:ManagementInformationReport"/>
    </message>
    <message name="ManagementInformationReportSoapOut">
        <part name="parameters" element="s0:ManagementInformationReportResponse"/>
    </message>
    <message name="OutOfPolicyReportSoapIn">
        <part name="parameters" element="s0:OutOfPolicyReport"/>
    </message>
    <message name="OutOfPolicyReportSoapOut">
        <part name="parameters" element="s0:OutOfPolicyReportResponse"/>
    </message>
    <portType name="ReportingSoap">
        <operation name="EmergencyReport">
            <input message="s0:EmergencyReportSoapIn"/>
            <output message="s0:EmergencyReportSoapOut"/>
        </operation>
        <operation name="ManagementInformationReport">
            <input message="s0:ManagementInformationReportSoapIn"/>
            <output message="s0:ManagementInformationReportSoapOut"/>
        </operation>
        <operation name="OutOfPolicyReport">
            <input message="s0:OutOfPolicyReportSoapIn"/>
            <output message="s0:OutOfPolicyReportSoapOut"/>
        </operation>
    </portType>
    <binding name="ReportingSoap" type="s0:ReportingSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="EmergencyReport">
            <soap:operation soapAction="http://corporate.micros.com/1.0/ws.Corporate.ReportingService.EmergencyReport" style="document"/>
            <input>
				<soap:header use="literal" message="s0:AuthorizationRequestSoapIn" part="ClientHeader" />
                <soap:header use="literal" message="s0:AuthorizationRequestSoapIn" part="Login" />
                <soap:header use="literal" message="s0:SourceRequestSoapIn" part="Source" />						
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="ManagementInformationReport">
            <soap:operation soapAction="http://corporate.micros.com/1.0/ws.Corporate.ReportingService.ManagementInformationReport" style="document"/>
            <input>
				<soap:header use="literal" message="s0:AuthorizationRequestSoapIn" part="ClientHeader" />
                <soap:header use="literal" message="s0:AuthorizationRequestSoapIn" part="Login" />
                <soap:header use="literal" message="s0:SourceRequestSoapIn" part="Source" />			
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="OutOfPolicyReport">
            <soap:operation soapAction="http://corporate.micros.com/1.0/ws.Corporate.ReportingService.OutOfPolicyReport" style="document"/>
            <input>
				<soap:header use="literal" message="s0:AuthorizationRequestSoapIn" part="ClientHeader" />
                <soap:header use="literal" message="s0:AuthorizationRequestSoapIn" part="Login" />
                <soap:header use="literal" message="s0:SourceRequestSoapIn" part="Source" />			
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>
    <service name="Reporting">
        <port name="ReportingSoap" binding="s0:ReportingSoap">
            <soap:address location="http://inntouch.slough.microsdc.com/csp/sql/ws.Corporate.ReportingService.cls"/>
        </port>
    </service>
</definitions>