<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:s0="http://corporate.micros.com" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             targetNamespace="http://corporate.micros.com">
    <types>
        <s:schema elementFormDefault="qualified" targetNamespace="http://corporate.micros.com">
            <s:include schemaLocation="../xsd/bart-business.xsd"/>
            <s:element name="SelfRegister">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" name="request" type="s0:SelfRegisterRequest"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="SelfRegisterRequest">
                <s:sequence>
                    <s:element name="companyName">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:maxLength value="40"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:element>
                    <s:element name="alternateName">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:maxLength value="40"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:element>
                    <s:element name="address" type="s0:Address"/>
                    <s:element name="contact" type="s0:SelfRegisterContact"/>
                    <s:element minOccurs="0" name="approxAnnualUKHotelSpend" type="s:string"/>
                    <s:element name="password" type="s:string"/>
                </s:sequence>
            </s:complexType>
            <s:complexType name="SelfRegisterContact">
                <s:complexContent>
                    <s:extension base="s0:Person">
                        <s:sequence>
                            <s:element name="emailAddress" type="s:string"/>
                            <s:element name="phoneNumber" type="s:string"/>
                        </s:sequence>
                    </s:extension>
                </s:complexContent>
            </s:complexType>
            <s:element name="SelfRegisterResponse">
                <s:complexType>
                    <s:sequence>
                        <s:element name="SelfRegisterResult" type="s0:SelfRegisterResponse"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="SelfRegisterResponse">
                <s:sequence>
                    <s:element name="sessionID" type="s:string"/>
                    <s:element minOccurs="0" name="isExistingCompany" type="s:boolean"/>
                    <s:element minOccurs="0" name="isExistingEmployee" type="s:boolean"/>
                    <s:element minOccurs="0" name="success" type="s:boolean"/>
                    <s:element minOccurs="0" name="errors" type="s0:ArrayOferrorError"/>
                </s:sequence>
            </s:complexType>
            <s:element name="UpdateRegistration">
                <s:complexType>
                    <s:sequence>
                        <s:element minOccurs="0" name="request" type="s0:UpdateRegistrationRequest"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="UpdateRegistrationRequest">
                <s:sequence>
                    <s:element name="sessionID" type="s:string"/>
                    <s:element name="companyID" type="s:string"/>
                    <s:element name="emailAddress" type="s:string"/>
                    <s:element name="approved" type="s:boolean"/>
                    <s:element name="accessLevel">
                        <s:simpleType>
                            <s:restriction base="s:string">
                                <s:enumeration value="STAYER"/>
                                <s:enumeration value="SELF"/>
                                <s:enumeration value="BOOKER"/>
                                <s:enumeration value="SUPER"/>
                            </s:restriction>
                        </s:simpleType>
                    </s:element>
                </s:sequence>
            </s:complexType>
            <s:element name="UpdateRegistrationResponse">
                <s:complexType>
                    <s:sequence>
                        <s:element name="UpdateRegistrationResult" type="s0:UpdateRegistrationResponse"/>
                    </s:sequence>
                </s:complexType>
            </s:element>
            <s:complexType name="UpdateRegistrationResponse">
                <s:sequence>
                    <s:element name="sessionID" type="s:string"/>
                    <s:element minOccurs="0" name="success" type="s:boolean"/>
                    <s:element minOccurs="0" name="errors" type="s0:ArrayOferrorError"/>
                </s:sequence>
            </s:complexType>
        </s:schema>
    </types>
    <message name="SelfRegisterSoapIn">
        <part name="parameters" element="s0:SelfRegister"/>
    </message>
    <message name="SelfRegisterSoapOut">
        <part name="parameters" element="s0:SelfRegisterResponse"/>
    </message>
    <message name="UpdateRegistrationSoapIn">
        <part name="parameters" element="s0:UpdateRegistration"/>
    </message>
    <message name="UpdateRegistrationSoapOut">
        <part name="parameters" element="s0:UpdateRegistrationResponse"/>
    </message>
    <portType name="SelfRegistrationSoap">
        <operation name="SelfRegister">
            <input message="s0:SelfRegisterSoapIn"/>
            <output message="s0:SelfRegisterSoapOut"/>
        </operation>
        <operation name="UpdateRegistration">
            <input message="s0:UpdateRegistrationSoapIn"/>
            <output message="s0:UpdateRegistrationSoapOut"/>
        </operation>
    </portType>
    <binding name="SelfRegistrationSoap" type="s0:SelfRegistrationSoap">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="SelfRegister">
            <soap:operation soapAction="http://corporate.micros.com/ws.Corporate.SelfRegistrationService.SelfRegister" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
        <operation name="UpdateRegistration">
            <soap:operation soapAction="http://corporate.micros.com/ws.Corporate.SelfRegistrationService.UpdateRegistration" style="document"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>
    <service name="SelfRegistration">
        <port name="SelfRegistrationSoap" binding="s0:SelfRegistrationSoap">
            <soap:address location="http://inntouch.slough.microsdc.com/csp/sql/ws.Corporate.SelfRegistrationService.cls"/>
        </port>
    </service>
</definitions>