					<xs:documentation>If appropriate as selected from a drop down list this will be the APIUserGUID for the selected users rather than the TetheredUserGuid</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CustomAttributes" type="tns:CustomAttributeType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
