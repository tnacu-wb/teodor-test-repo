	<xs:complexType name="CustomerAccountBalanceDetailsType">
		<xs:sequence>
			<xs:element name="OutstandingBalanceAtRisk" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>A. OS_Balance from scheme database + DD payments and cheques which have not yet included in the available balance (authorisation)  Or B + O</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutstandingBalance" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>B. OS_Balance from scheme database</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AvailableToSpend" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>C. This is the balance on OLA platform and reflects what the credit the account has. It is a revolving balance and is a sum of all the debits and credits taken away from the credit limit. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CreditLimit" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>D. Held on the customer table</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CurrentSpend" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>E = D-C</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpendSinceLastInvoice" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>F = G + H + I</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PendingTransactions" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>G . Authorisations where no settlement has been received.  Purchase minus Refunds 

</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransactionsReadyToBeInvoicedWithL3" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>H.Uninvoiced transactions from scheme database where there is a match to level 3</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TransactionsReadyToBeInvoicedWithoutLevel3" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>I. Uninvoiced transactions from scheme database where there is not a level 3 match  </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LastStatement" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>J. How much owed when the last invoice was generated - from invoice trailer record</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DepositReceived" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>K. Deposit was received (if applicable)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DepositReturned" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>L. Deposit was returned (if applicable)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DepositBalance" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>M. The value of deposit received (if applicable) K-L</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PayAdjustSinceLastStatement" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>N. Payments/adjustments since last statement (uninvoiced payments, excluding *future* DDs)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScheduledPayments" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>O. Future  DDs</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterimPaymentsSinceLastStatement" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>P.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CashBalance" type="tns:CurrencyType">
				<xs:annotation>
					<xs:documentation>Q. Cash Balance</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CB_Period_1" type="tns:CurrencyType"/>
			<xs:element name="CB_Period_2" type="tns:CurrencyType"/>
			<xs:element name="CB_Period_3" type="tns:CurrencyType"/>
			<xs:element name="CB_Period_4" type="tns:CurrencyType"/>
			<xs:element name="CB_Period_5" type="tns:CurrencyType"/>
			<xs:element name="CustomAttributes" type="tns:CustomAttributeType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
