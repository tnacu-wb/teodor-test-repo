	<xs:complexType name="SessionTokenType">
		<xs:annotation>
			<xs:documentation>Session token (generated by client and passed to Worldline)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SessionId">
				<xs:annotation>
					<xs:documentation>The sessionId value returned during the login process</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
						<xs:whiteSpace value="collapse"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Nonce">
				<xs:annotation>
					<xs:documentation>Random "number used once" value generated by caller.  We recommend Base64 encoding a random GUID for this purpose.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="collapse"/>
						<xs:maxLength value="50"/>
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Timestamp" type="xs:string">
				<xs:annotation>
					<xs:documentation>Passed as a string to ensure cryptographic hash will be accurate.  This should be the current UTC date in the format: yyyy-MM-ddTHH:mm:ss</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Hash">
				<xs:annotation>
					<xs:documentation>SHA256 hash of above values + shared secret</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="collapse"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CustomAttributes" type="tns:CustomAttributeType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
