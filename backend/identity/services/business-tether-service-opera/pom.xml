<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uk.co.whitbread</groupId>
        <artifactId>digital-monorepo-service-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../../parents/service-parent/pom.xml</relativePath>
    </parent>

    <artifactId>business-tether-service-opera</artifactId>
    <packaging>jar</packaging>

    <properties>
        <sonar.coverage.exclusions>
            **/model/**,
            **/properties/**,
            **/utils/**,
            **BusinessTetherServiceApplication*
        </sonar.coverage.exclusions>
    </properties>

    <name>business-tether-service-opera</name>
    <description>Whitbread Business Tether Micro-Service</description>

    <dependencies>

        <!-- Whitbread -->
        <dependency>
            <groupId>uk.co.whitbread.shared</groupId>
            <artifactId>commons-cdh-lib</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>

        <!-- Micrometer tracing - needed for Tracer class, version managed by Spring Boot -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- Spring/SpringBoot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web-services</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- For Feign Client Dependency-->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- Swagger dependency-->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Other dependencies -->
        <dependency>
            <groupId>uk.co.whitbread.shared</groupId>
            <artifactId>worldline-ba-api-lib</artifactId>
        </dependency>

        <dependency>
            <groupId>uk.co.whitbread.shared</groupId>
            <artifactId>commons-exceptions</artifactId>
        </dependency>

        <dependency>
            <groupId>uk.co.whitbread.shared</groupId>
            <artifactId>common-auth0</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- Test dependencies-->
        <dependency>
            <groupId>org.wiremock.integrations</groupId>
            <artifactId>wiremock-spring-boot</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/uk/co/whitbread/business/tether/model/**</exclude>
                        <exclude>**/uk/co/whitbread/business/tether/properties/**</exclude>
                        <exclude>**/uk/co/whitbread/business/tether/utils/**</exclude>
                        <exclude>**/uk/co/whitbread/business/tether/BusinessTetherServiceApplication*</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <baseClassForTests>uk.co.whitbread.business.tether.controller.ContractVerifierBaseTest
                    </baseClassForTests>
                    <nameSuffixForTests>IT</nameSuffixForTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <excludedClasses>
                        <param>uk.co.whitbread.business.tether.BusinessTetherServiceApplication</param>
                    </excludedClasses>
                    <excludedTestClasses>
                        <excludedTestClass>
                            uk.co.whitbread.reservation.architecture.ArchUnitTests
                        </excludedTestClass>
                    </excludedTestClasses>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
