{
  "request": {
    "urlPath": "/v1/content/booking/rateInformation",
    "method": "GET",
    "queryParameters" : {
      "brand": {
        "equalTo": "pi"
      },
      "country": {
        "equalTo": "gb"
      },
      "language": {
        "equalTo": "en"
      },
      "hotelId": {
        "equalTo": "DUBAIR"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "information/opera/reservations_rateInformation.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}