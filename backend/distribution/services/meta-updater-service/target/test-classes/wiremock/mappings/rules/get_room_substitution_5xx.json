{
  "request": {
    "urlPathPattern": "/v1/rules/5xx",
    "method": "GET",
    "queryParameters": {
      "adults": {
        "equalTo": "1"
      },
      "children": {
        "equalTo": "0"
      },
      "pms": {
        "equalTo": "OP"
      },
      "roomType": {
        "equalTo": "DB"
      },
      "channel": {
        "equalTo": "PI"
      }
    }
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "application/json"
    }
  }
}