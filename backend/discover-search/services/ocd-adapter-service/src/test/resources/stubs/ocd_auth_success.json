{
  "request": {
    "url": "/hdpba/oauth2/v1/token",
    "method": "POST"
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "expires_in": 3600,
      "token_type": "Bearer",
      "oracle_tk_context": "user_assertion",
      "refresh_token": "token",
      "oracle_grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
      "access_token": "token"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}