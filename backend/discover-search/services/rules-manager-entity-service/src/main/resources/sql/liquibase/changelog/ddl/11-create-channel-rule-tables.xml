<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet author="octavian.salcianu" id="create_tables_channel_rule" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="channel_rule"/>
                <tableExists tableName="channel_rate_plan_sets" />
            </not>
        </preConditions>

        <createTable tableName="channel_rule">
            <column name="rule_id" autoIncrement="true" remarks="rule_id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="channel_rule_pkey"/>
            </column>

            <column name="ref_rule_id" type="integer">
                <constraints nullable="true" foreignKeyName="channel_rule_ref_rule_id_fkey"
                    references="channel_rule(rule_id)"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="NEW">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="last_modified_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="enable_timestamp" type="TIMESTAMP WITHOUT TIME ZONE">
            </column>
            <column name="disable_timestamp" type="TIMESTAMP WITHOUT TIME ZONE">
            </column>

            <column name="pms" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="channel" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            
            <column name="subchannel" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="language" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="source_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            
        </createTable>

        <addUniqueConstraint
          columnNames="channel, subchannel, language"
          constraintName="unique_channel_constraint"
          tableName="channel_rule"
        />
        
        <createTable tableName="channel_rate_plan_sets">
            <column name="ref_channel_rule_id" type="integer">
                <constraints nullable="false" foreignKeyName="channel_rate_plan_sets_ref_rule_id_fkey"
                  references="channel_rule(rule_id)"/>
            </column>
            <column name="rate_plan_set" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>