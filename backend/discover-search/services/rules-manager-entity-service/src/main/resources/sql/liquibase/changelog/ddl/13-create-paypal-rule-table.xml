<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet author="joshua.mathew" id="create_table_paypal_rule" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="paypal_rule"/>
            </not>
        </preConditions>

        <createTable tableName="paypal_rule">
            <column name="rule_id" autoIncrement="true" remarks="rule_id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="paypal_rule_pkey"/>
            </column>

            <column name="ref_rule_id" type="integer">
                <constraints nullable="true" foreignKeyName="paypal_rule_ref_rule_id_fkey"
                    references="paypal_rule(rule_id)"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="NEW">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="last_modified_at" type="TIMESTAMP WITHOUT TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="enable_timestamp" type="TIMESTAMP WITHOUT TIME ZONE">
            </column>
            <column name="disable_timestamp" type="TIMESTAMP WITHOUT TIME ZONE">
            </column>

            <column name="channel_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="country" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="hotel_id_list" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>