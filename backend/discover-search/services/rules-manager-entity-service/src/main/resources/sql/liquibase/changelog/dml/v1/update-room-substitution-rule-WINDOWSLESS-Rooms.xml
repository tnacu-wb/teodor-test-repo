    <changeSet author="adrian.santa" id="update_room_substitution_rule_WINDOWSLESS_Rooms">
        <loadUpdateData tableName="room_substitution_rule"
                        file="sql/liquibase/data/room_substitution_rule_WINDOWSLESS_Rooms.csv"
                        primaryKey="rule_id"/>

        <rollback>
            <delete schemaName="rules_engine" tableName="room_substitution_rule">
                <where>rule_id BETWEEN 2101 AND 2168</where>
