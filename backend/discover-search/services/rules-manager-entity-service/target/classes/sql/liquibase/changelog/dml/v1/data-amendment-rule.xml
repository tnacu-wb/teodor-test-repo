  <changeSet author="ippili-wb" id="update_free_breakfast_promotional_rate">
    <update schemaName="rules_engine"
            tableName="amendment_rule">
      <column name="rate_type" value="PROBRKST"/>
      <where>rate_type='PROBF'</where>
    </update>
    <update schemaName="rules_engine" tableName="amendment_rule">
      <column name="arrival_date_limit" value="39600"/>
      <where>rate_type = 'PROBRKST' AND country_code IN ('JE','GB','IE','GG','IM')</where>
    </update>

    <update schemaName="rules_engine" tableName="amendment_rule">
      <column name="arrival_date_limit" value="21600"/>
      <where>rate_type = 'PROBRKST' AND country_code = 'DE'</where>
    </update>

    <rollback>
      <update schemaName="rules_engine" tableName="amendment_rule">
        <column name="arrival_date_limit" valueComputed="NULL"/>
        <where>rate_type = 'PROBRKST' AND country_code IN ('JE','GB','IE','GG','IM','DE')</where>
      </update>
      <update schemaName="rules_engine"
              tableName="amendment_rule">
        <column name="rate_type" value="PROBF"/>
        <where>rate_type = 'PROBRKST'</where>
      </update>
    </rollback>
  </changeSet>

