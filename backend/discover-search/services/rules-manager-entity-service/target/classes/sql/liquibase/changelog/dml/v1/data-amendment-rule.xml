  <changeSet author="marina.baban" id="init_data_amendment_rule_flex_noflex" runOnChange="true">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="amendment_rule"/>

        <sqlCheck expectedResult="0">select count(*) from rules_engine.amendment_rule</sqlCheck>
      </and>
    </preConditions>

    <loadData tableName="amendment_rule" file="sql/liquibase/data/amendment_rule_flex_noflex_data.csv"/>
  </changeSet>

  <changeSet author="marina.baban" id="drop_columns_channelId_userCategory_originalBookingTimeLimit" runOnChange="true">
    <dropColumn
      schemaName="rules_engine"
      tableName="amendment_rule">
      <column name="channel_id"/>
    </dropColumn>

    <dropColumn
      schemaName="rules_engine"
      tableName="amendment_rule">
      <column name="user_category"/>
    </dropColumn>

    <dropColumn
      schemaName="rules_engine"
      tableName="amendment_rule">
      <column name="original_booking_time_limit"/>
    </dropColumn>
  </changeSet>

