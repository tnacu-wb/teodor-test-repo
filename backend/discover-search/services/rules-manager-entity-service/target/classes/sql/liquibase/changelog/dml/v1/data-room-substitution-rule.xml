<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet author="linda.szasz" id="init_data_room_substitution_rule" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="room_substitution_rule"/>

                <sqlCheck expectedResult="0">select count(*) from rules_engine.room_substitution_rule</sqlCheck>
            </and>
        </preConditions>

        <loadData tableName="room_substitution_rule" file="sql/liquibase/data/room_substitution_rule_data.csv"/>
    </changeSet>

    <changeSet author="linda.szasz" id="update-room-substitution-accessible-room-type">
        <update schemaName="rules_engine"
          tableName="room_substitution_rule">
            <column name="room_type" value="DIS"/>
            <where>room_type='Accessible'</where>
        </update>
    </changeSet>

    <changeSet author="linda.szasz" id="update-room-substitution-double-room-type">
        <update schemaName="rules_engine"
          tableName="room_substitution_rule">
            <column name="room_type" value="DB"/>
            <where>room_type='Double'</where>
        </update>
    </changeSet>

    <changeSet author="linda.szasz" id="update-room-substitution-family-room-type">
        <update schemaName="rules_engine"
          tableName="room_substitution_rule">
            <column name="room_type" value="FAM"/>
            <where>room_type='Family'</where>
        </update>
    </changeSet>

