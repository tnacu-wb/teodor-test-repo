    <changeSet author="octavian.horvat" id="delete_FMTRPL_for_FAM_substitution">
        <delete schemaName="rules_engine" tableName="room_substitution_rule">
            <where>(room_type='FAM' AND adults=1 AND children=2 AND channel!='CCUI'
                AND (pms_room_type='FMTHRE' OR pms_room_type='FMTRPL' OR pms_room_type='FMTRSC') )</where>
        </delete>
    </changeSet>

