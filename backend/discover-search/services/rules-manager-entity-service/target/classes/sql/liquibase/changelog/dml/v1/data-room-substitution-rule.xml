        <loadUpdateData tableName="room_substitution_rule"
          file="sql/liquibase/data/room_substitution_new_rules_data.csv" primaryKey="rule_id"/>
    </changeSet>

    <changeSet author="linda.szasz" id="addColumn-special_request-in-room-substitution">
        <addColumn schemaName="rules_engine"
          tableName="room_substitution_rule">
            <column name="special_request" type="varchar(255)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

