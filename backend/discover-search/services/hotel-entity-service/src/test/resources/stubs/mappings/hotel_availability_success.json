{
  "request": {
    "urlPathPattern": "/hotels/TKINPT/availabilities",
    "method": "GET",
    "queryParameters": {
      "arrivalDate": {
        "equalToDateTime": "now",
        "truncateExpected": "first hour of day"
      },
      "departureDate": {
        "equalToDateTime": "now +3 days",
        "truncateExpected": "first hour of day"
      },
      "roomTypes": {
        "equalTo": "DB,DB"
      },
      "adults": {
        "equalTo": "1,2"
      },
      "children": {
        "equalTo": "0,0"
      },
      "cotsRequired": {
        "equalTo": "false,false"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "hotelAvailability.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}