{
  "request": {
    "urlPathPattern": "/hotels/TESTER/rate-code-pricing",
    "method": "GET",
    "queryParameters": {
      "arrivalDate": {
        "equalTo": "2022-12-20"
      },
      "departureDate": {
        "equalTo": "2022-12-28"
      },
      "ratePlanCode": {
        "equalTo": "FLEXRATE"
      },
      "roomTypes": {
        "equalTo": "DOUBLE,DOUBLE"
      },
      "adultsNo": {
        "equalTo": "1,1"
      },
      "childrenNo": {
        "equalTo": "1"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "ohip_adapter_rate_code_pricing_success_response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}