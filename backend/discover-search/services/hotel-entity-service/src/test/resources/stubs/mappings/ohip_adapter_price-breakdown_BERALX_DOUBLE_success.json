        "equalTo": "2"
      },
      "childrenNo": {
        "equalTo": "0"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "ohip_adapter_price-breakdown_BERALX_DOUBLE_success_response.json",
