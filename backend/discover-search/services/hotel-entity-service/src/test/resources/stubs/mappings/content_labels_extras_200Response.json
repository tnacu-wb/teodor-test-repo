{
  "request": {
    "method": "GET",
    "urlPath": "/v1/content/labels/extras",
    "queryParameters": {
      "country": {
        "equalTo": "gb"
      },
      "language": {
        "equalTo": "en"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "extrasLabels": [
        {
          "id": "HSCKIN",
          "referenceDateType": "START_DATE",
          "requiresInventory": true
        }
      ],
      "extrasList": ["HSCKIN"]
    }
  }
}