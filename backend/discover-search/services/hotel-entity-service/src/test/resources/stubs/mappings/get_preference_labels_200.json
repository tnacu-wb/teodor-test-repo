{
  "request": {
    "urlPathPattern": "/v1/content/labels/main",
    "method": "GET",
    "queryParameters": {
      "country": {
        "equalTo": "gb"
      },
      "language": {
        "equalTo": "en"
      },
      "labels": {
        "equalTo": "booking.confirmation.specialOccasion.list"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "get_content_preferences_labels.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}