{
  "request": {
    "urlPath": "/rtp/v1/packages",
    "method": "GET",
    "queryParameters": {
      "hotelId": {
        "equalTo": "HOTELCODE"
      },
      "packageCode": {
        "equalTo": "CHRTY1"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "ohip_get_donation_packages_success_response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}