{
  "request": {
    "urlPath": "/rtp/v1/packages",
    "method": "GET",
    "queryParameters": {
      "hotelId": {
        "equalTo": "HOTELCODE"
      },
      "startDate": {
        "equalTo": "2022-04-02"
      },
      "endDate": {
        "equalTo": "2022-04-03"
      },
      "adults": {
        "equalTo": "1"
      },
      "children": {
        "equalTo": "0"
      },
      "sellSeparate": {
        "equalTo": "true"
      },
      "includeGroup": {
        "equalTo": "true"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "ohip_get_packages_success_response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}