              <typeMappings><typeMapping>OffsetDateTime=Date</typeMapping></typeMappings>
              <importMappings><importMapping>java.time.OffsetDateTime=java.util.Date</importMapping></importMappings>
              <generateApis>false</generateApis>
              <generateApiDocumentation>false</generateApiDocumentation>
