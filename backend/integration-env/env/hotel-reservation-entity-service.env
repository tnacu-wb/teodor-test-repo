# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-Xms64m -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5013 -Dlogging.level.uk.co.whitbread=DEBUG

# Available downstream services
BASKET_SERVICE_HOST=basket-service:9104
OHIP_HOST=ohip-adapter-service:9100
CONTENT_SERVICE_HOST=content-entity-service:9106
CDH_ADAPTER_HOST=cdh-adapter-service:9119
RULES_AGENT_HOST=rules-agent-entity-service:9108
HOTEL_ENTITY_HOST=hotel-entity-service:9102

# Newly available downstream services
HOTEL_ACCOUNT_HOST=hotel-account-service-opera:9020

# Downstream services intentionally not present in integration-env
PROMO_SERVICE_HOST=promo-service.not-in-integration-env.invalid

# Auth0/JWKS. Integration tests install the matching JWKS into WireMock CDH/Auth0.
CCUI_TENANT_ISSUER=https://mock-ccui-auth0-domain/
CCUI_TENANT_AUDIENCE=https://mock-ccui-auth0-audience/
CCUI_TENANT_NAMESPACE=https://mock-ccui
CCUI_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json
PI_BB_TENANT_ISSUER=https://mock-auth0-domain/
PI_BB_TENANT_AUDIENCE=https://mock-auth0-audience/api/v2/
PI_BB_TENANT_NAMESPACE=https://premierinn.com
PI_BB_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json
DISTR_TENANT_ISSUER=https://mock-distribution-auth0-domain/
DISTR_TENANT_AUDIENCE=https://mock-distribution-auth0-audience/
DISTR_TENANT_NAMESPACE=https://premierinn.com
DISTR_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit
INTEGRATION_TESTS_FEATURE_FLAG_OVERRIDES_ENABLED=true

# Cache is deliberately disabled for the integration environment.
CACHE_TYPE=none

# Application configuration mirrored from the DIT Helm values.
COMPANY_ID=66471
PROMOTIONAL_PACKAGES=OBFPRO,HSCKIF,FHSCOU2,FIFR24
CIOL_RATES=EMPLOYEE,HOUSEUSE,EMERALD1,GP,BS,TP,TM,NONFBKBB,NONFBOOK
CIOL_HOTELS=EXCLUDE
CIOL_COUNTRY_CODES=GB,IE,DE
CIOL_MAX_ROOMS=4
DAYS_WITHIN_ARRIVAL=2
CIOL_EMAILS=
MDP_PACKAGES=MDBFST,MDBEVA,MD2DIN
COOL_DAYS_UNTIL_DEPARTURE=1
COOL_RSV_STATUS=Reserved,InHouse
DE_REG_CARD_HOTELS=FRAMTI,WIECIT,FRESUD
DE_REG_CARD_ROOMS=4
COOL_STARTING_HOUR=5
COOL_ENDING_HOUR=18
COOL_ENDING_HOUR_LCO=20
COOL_PILOT_HOTELS=FRAMTI,WIECIT,FRESUD
DK_HOTELS=LINMIL,FRAMTI,FRAWES,MANOLD,EDIPAR,LONTAL,LONBAI,LONKIN,BERWIL,BERSPI,BERSUD
DK_MAX_ROOMS=1
DK_RESERVATION_STATUES=Reserved,InHouse
PROVIDERS=EXPEDIA
DAYS_WITHIN_ARRIVAL_FOR_THIRD_PARTY=1
OPERA_CONFIRMATION_CONFIG_BIC_ENABLED=false
