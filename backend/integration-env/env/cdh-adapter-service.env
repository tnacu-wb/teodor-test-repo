# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5007 -Dlogging.level.uk.co.whitbread=DEBUG

# CDH API (routed to WireMock CDH/Auth0 container)
CDH_API_HOST=http://wiremock-cdh-auth0:8080
CDH_OAUTH_CLIENT_HOST=http://wiremock-cdh-auth0:8080
AZURE_OAUTH_CLIENT_TOKEN_URL=

# OAuth credentials (mock placeholders)
CDH_OAUTH_SCOPE=mock-cdh-scope
AZURE_FDID=mock-azure-fdid
ACCOUNT_HUB_OAUTH_SUBSCRIPTION_KEY=mock-account-hub-subscription-key
BOOKING_HUB_OAUTH_SUBSCRIPTION_KEY=mock-booking-hub-subscription-key
INN_BUSINESS_OAUTH_SUBSCRIPTION_KEY=mock-inn-business-subscription-key
AZURE_OAUTH_CLIENT_CLIENT_SECRET=mock-client-secret
AZURE_OAUTH_CLIENT_CLIENT_ID=mock-client-id

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit
