# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-Xms64m -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5012 -Dlogging.level.uk.co.whitbread=DEBUG

# Available downstream services
CONTENT_HOST=content-entity-service:9106
OHIP_HOST=ohip-adapter-service:9100
CDH_ADAPTER_HOST=cdh-adapter-service:9119
RULES_AGENT_HOST=rules-agent-entity-service:9108
AUTH_RULESENGINEHOST=http://rules-agent-entity-service:9108
RESERVATION_HOST=hotel-reservation-entity-service:9103
HOTEL_ENTITY_HOST=hotel-entity-service:9102

# Newly available downstream services
THREEC_HOST=threec-payment-service-opera:9001

# Downstream services intentionally not present in integration-env
MARKETING_HOST=http://marketing-service-opera.not-in-integration-env.invalid
REFUND_REQUEST_PROCESSOR=refund-request-processor.not-in-integration-env.invalid
PROMO_SERVICE_HOST=promo-service.not-in-integration-env.invalid

# Auth0/JWKS. Integration tests install the matching JWKS into WireMock CDH/Auth0.
CCUI_TENANT_ISSUER=https://mock-ccui-auth0-domain/
CCUI_TENANT_AUDIENCE=https://mock-ccui-auth0-audience/
CCUI_TENANT_NAMESPACE=https://mock-ccui
CCUI_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json
PI_BB_TENANT_ISSUER=https://mock-auth0-domain/
PI_BB_TENANT_AUDIENCE=https://mock-auth0-audience/api/v2/
PI_BB_TENANT_NAMESPACE=https://premierinn.com
PI_BB_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit

# Cache is disabled. Redis auto-configuration and health checks are disabled.
CACHE_TYPE=none
MANAGEMENT_HEALTH_REDIS_ENABLED=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
TOPICS_ORDERS=orders
TOPICS_REFUNDS=refunds
TOPICS_NOTIFICATIONS=notifications

# DynamoDB Local
AMAZON_DYNAMODB_IRSA=false
AMAZON_DYNAMODB_ENDPOINT=http://dynamodb-local:8000
AMAZON_DYNAMODB_ACCESSKEY=key
AMAZON_DYNAMODB_SECRETKEY=secret
DYNAMODB_TABLE_BASKET_NAME=newBasket
DYNAMODB_TABLE_PREPAID_BOOKING_CHARGES_NAME=PrepaidBookingCharges
DYNAMODB_TABLE_BASKET_REGION=eu-west-1

# Application configuration
CITY_TAX=CITYTAX,CITYEXP
