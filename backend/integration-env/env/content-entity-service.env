# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5006 -Dlogging.level.uk.co.whitbread=DEBUG

# AEM/content dependencies (routed to WireMock AEM container)
CONFIG_MAP_AEM_URL=http://wiremock-aem:8080
AEM_CREDENTIALS_ENV_USER=mock-username
AEM_CREDENTIALS_ENV_PASS=mock-password
CONFIG_MAP_IS_PROD=true

# Downstream service dependencies
SNOWDROP_URL=http://wiremock-opera:8080
OHIP_HOST=ohip-adapter-service:9100
CONFIG_SERVICE_HOTELREVIEWSERVICE_HOST=http://wiremock-opera:8080

# Cache is disabled.
CACHE_TYPE=none

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit
