# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5008 -Dlogging.level.uk.co.whitbread=DEBUG

# Cache is disabled.
CACHE_TYPE=none
MANAGEMENT_HEALTH_REDIS_ENABLED=false
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.data.redis.autoconfigure.DataRedisAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.DataRedisReactiveAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.DataRedisRepositoriesAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.health.DataRedisHealthContributorAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.health.DataRedisReactiveHealthContributorAutoConfiguration

# CDH API (routed to WireMock CDH/Auth0 container)
CDH_API_HOST=http://wiremock-cdh-auth0:8080
CDH_API_IS_OAUTH=true
CDH_OAUTH_IS_ENABLED=true
CDH_OAUTH_HOST=http://wiremock-cdh-auth0:8080
CDH_OAUTH_SCOPE=mock-cdh-scope
CDH_OAUTH_GRANT_TYPE=client_credentials
AZURE_OAUTH_CLIENT_TOKEN_URL=
AZURE_OAUTH_CLIENT_CLIENT_ID=mock-client-id
AZURE_OAUTH_CLIENT_CLIENT_SECRET=mock-client-secret
INN_BUSINESS_OAUTH_SUBSCRIPTION_KEY=mock-inn-business-subscription-key
CDH_ENABLE_BB_DATA_FETCH=false

# Worldline (routed to WireMock Worldline container)
WORLDLINE_HOST=http://wiremock-worldline-datatrans:8080
PIBA_ACCOUNT_WORLDLINE_SERVICE_URL=http://wiremock-worldline-datatrans:8080/b2b.pi.v1.1/b2bpiapi.svc
PIBA_ACCOUNT_WORLDLINE_GB_URL=http://wiremock-worldline-datatrans:8080/b2b.pi.v1.1/b2bpiapi.svc
PIBA_ACCOUNT_WORLDLINE_DE_URL=http://wiremock-worldline-datatrans:8080/b2b.pi.v1.1/b2bpiapi.svc
PIBA_ACCOUNT_WORLDLINE_TETHERING_PLUS_ENABLED=true
WORLDLINE_CLIENT_MESSAGE_ID=mock-client-message-id
WORLDLINE_USERNAME=mock-username
WORLDLINE_PASSWORD=mock-password
WORLDLINE_DE_CLIENT_MESSAGE_ID=mock-de-client-message-id
WORLDLINE_DE_USERNAME=mock-de-username
WORLDLINE_DE_PASSWORD=mock-de-password
WORLDLINE_REST_USERNAME_GB=mock-rest-username-gb
WORLDLINE_REST_PASSWORD_GB=mock-rest-password-gb
WORLDLINE_REST_USERNAME_DE=mock-rest-username-de
WORLDLINE_REST_PASSWORD_DE=mock-rest-password-de
WORLDLINE_CULTURE_CODE_GB=en-GB
WORLDLINE_CULTURE_CODE_DE=de-DE
WORLDLINE_COMPANY_NUMBER_GB=35
WORLDLINE_COMPANY_NUMBER_DE=91

# Auth0 (mock placeholders)
AUTH0_CLIENTID=mock-auth0-client-id
AUTH0_CLIENTSECRET=mock-auth0-client-secret
AUTH_MNGMT_DOMAIN=http://wiremock-cdh-auth0:8080
AUTH_MNGMT_AUDIENCE=https://mock-auth0-audience/api/v2/
AUTH_MNGMT_CONNECTION=auth0-users
AUTH_TOKEN_PROVIDERS_DOMAIN=https://mock-auth0-domain
AUTH_TOKEN_PROVIDERS_HOST=https://mock-auth0-domain
AUTH_TOKEN_PROVIDERS_ISSUER=https://mock-auth0-domain/
PI_BB_TENANT_ISSUER=https://mock-auth0-domain/
PI_BB_TENANT_AUDIENCE=https://mock-auth0-audience/api/v2/
PI_BB_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json
PI_BB_TENANT_NAMESPACE=https://premierinn.com

# PIBA GUID
PIBA_GUID_URL=wiremock-worldline-datatrans:8080
