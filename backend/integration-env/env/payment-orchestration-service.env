# Spring
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=-Xms64m -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5016 -Dlogging.level.uk.co.whitbread=DEBUG

# Temporal workflow engine (auto-setup image, backed by the shared unleash-postgres)
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233

# Datatrans payment gateway. The real HTTP adapter (DatatransRestAdapter) targets this
# base URL; stub mappings are installed by the integration-testing framework at runtime.
# Reuses the shared wiremock-worldline-datatrans instance.
DATATRANS_BASE_URL=http://wiremock-worldline-datatrans:8080
DATATRANS_MERCHANT_ID=sandbox-merchant-id
DATATRANS_MERCHANT_PASSWORD=sandbox-password

# Hotel Reservation Entity Service. ReservationServiceClient calls
# GET /v1/reservations/basket/{basketReference} on every payment initialisation, so this
# must resolve to the in-stack service. The current application configuration uses this
# value as the complete RestClient base URL, so the scheme is required.
RESERVATION_HOST=http://hotel-reservation-entity-service:9103
PAYMENT_METHOD_SERVICE_HOST=http://payment-methods-entity-service:9107
BASKET_SERVICE_HOST=http://basket-service:9104

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# The OPERA adapter is still a local stub. This value is reserved for its HTTP implementation.
OPERA_BASE_URL=http://wiremock-opera:8080

# Registers the Temporal client interceptor that carries wb-test-id baggage across
# Update-With-Start, without which the workflow's activities call downstream services with no
# baggage and every scoped WireMock stub misses. Test-stack only by design: the interceptor
# depends on an internal temporal-opentracing package and is kept off deployed request paths.
TEMPORAL_TRACING_UPDATE_WITH_START_ENABLED=true
