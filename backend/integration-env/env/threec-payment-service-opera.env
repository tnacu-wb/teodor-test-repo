# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-Xms64m -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5020 -Dlogging.level.uk.co.whitbread=DEBUG

# Available downstream services
BASKET_SERVICE_HOST=basket-service
BASKET_BOOKING_PORT=9104

# Downstream services intentionally not present in integration-env
HOTEL_MAKE_BOOKING_HOST=http://hotel-booking-service.not-in-integration-env.invalid
HOTEL_BOOKING_HOST=http://hotel-booking-service.not-in-integration-env.invalid
HOTEL_CARD_HOST=http://hotel-card-service-opera.not-in-integration-env.invalid

# Client timeouts
HOTEL_BOOKING_CONNECTION=10000
HOTEL_BOOKING_RESPONSE=30000
BASKET_BOOKING_CONNECTION=10000
BASKET_BOOKING_RESPONSE=30000
HOTEL_CARD_CONNECTION=10000
HOTEL_CARD_RESPONSE=30000

# 3C provider
THREEC_SERVER=http://wiremock-worldline-datatrans:8080
THREEC_IPAGE_IS_STUB_MODE=true
THREEC_PAYMENT_SERVICE_VALIDATION_CODE=unused
THREEC_USERNAME_DEFAULT=unused
THREEC_USERNAME_TOKENISATION=unused
THREEC_USERNAME_TOKENISATION_DE=unused
THREEC_INITIAL_TTL=3600
THREEC_FINAL_TTL=86400
THREEC_PAYMENT_SERVICE_API_KEY=unused
HOTEL_CODES_LIST=

# Redirects and webhooks
WEBHOOK_ENVIRONMENT=http://threec-payment-service-opera:9001
REDIRECT_ENVIRONMENT=http://threec-payment-service-opera:9001
REDIRECT_DEFAULT_URL=http://threec-payment-service-opera:9001
BASKET_BOOKING_SECURITY_VALUE=unused

# PayPal
THREEC_PAYMENT_SERVICE_PAYPAL_MERCHANT_ID=unused
THREEC_PAYMENT_SERVICE_PAYPAL_PUBLIC_KEY=unused
THREEC_PAYMENT_SERVICE_PAYPAL_PRIVATE_KEY=unused
PAYPAL_ENVIRONMENT=development
GATEWAY_BASE_URL=http://wiremock-worldline-datatrans
GATEWAY_PORT=8080
GRAPHQL_URL=http://wiremock-worldline-datatrans:8080/graphql
PAYPAL_ACCOUNT_NAMES_VALUE_GB=unused
PAYPAL_ACCOUNT_NAMES_VALUE_DE=unused
PAYPAL_TRANSACTIONS_URL=http://wiremock-worldline-datatrans:8080
PAYPAL_MIT_COF_INDICATOR=unused
ENABLE_PAYPAL_CONFIG_DATA=false
PAYPAL_CONFIG_DATA_NAME=unused
PAYPAL_CONFIG_DATA_URL=http://wiremock-worldline-datatrans:8080
PAYPAL_URL=http://wiremock-worldline-datatrans:8080
ENABLE_PAYPAL_TEST_CARD=false

# DynamoDB Local
THREEC_DYNAMODB_TABLE_NAME=threec-payment
THREEC_DYNAMODB_IS_IRSA=false
AMAZON_DYNAMODB_ENDPOINT=http://dynamodb-local:8000
AMAZON_DYNAMODB_ACCESSKEY=key
AMAZON_DYNAMODB_SECRETKEY=secret
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# Feature configuration
ECKOH_ENABLED=false
REVISED_SOLUTION_IS_FEATURE_ENABLED=false
REVISED_SOLUTION_IS_MOBILE_APP_ENABLED=false
REVISED_SOLUTION_IS_ANDROID_APP_ENABLED=false
REVISED_SOLUTION_IS_IOS_APP_ENABLED=false
REVISED_SOLUTION_IS_MOTO_BOOKING_ENABLED=false
REVISED_SOLUTION_HOTEL_LIST=
IS_MANAGEMENT_SECURITY_ENABLED=false

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit
