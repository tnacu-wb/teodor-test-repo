# Spring
# opera-dev keeps the env-driven datasource below and enables the polling scheduler.
SPRING_PROFILES_ACTIVE=opera-dev
JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5014 -Dlogging.level.uk.co.whitbread=DEBUG

# PostgreSQL
# Reads the rules_engine schema created and seeded by rules-manager-entity-service.
Cluster_Read_End_Point=unleash-postgres:5432
Database_Name=rulesmanager
Database_User_Name=unleash
Database_Password=unleash
