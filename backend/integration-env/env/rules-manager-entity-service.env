# Spring
# opera-dev keeps the env-driven datasource below (the 'local' profile would hard-code
# localhost:5438) and exposes the metrics actuator endpoint.
SPRING_PROFILES_ACTIVE=opera-dev
JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5010 -Dlogging.level.uk.co.whitbread=DEBUG

# PostgreSQL
# Reuses the shared unleash-postgres instance via a dedicated 'rulesmanager' database
# (created by postgres/init/01-rulesmanager.sql). Liquibase manages the rules_engine schema.
Cluster_Write_End_Point=unleash-postgres:5432
Database_Name=rulesmanager
Database_User_Name=unleash
Database_Password=unleash
