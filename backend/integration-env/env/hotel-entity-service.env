# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-Xms64m -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5015 -Dlogging.level.uk.co.whitbread=DEBUG

# Available downstream services
OHIP_HOST=http://ohip-adapter-service:9100
RULES_AGENT_ENTITY_HOST=http://rules-agent-entity-service:9108
CONTENT_SERVICE_HOST=http://content-entity-service:9106
BASKET_SERVICE_HOST=basket-service:9104
CDH_ADAPTER_SERVICE_HOST=cdh-adapter-service:9119
COMPANY_ENTITY_SERVICE_HOST=company-entity-service:9118
COMPANY_SERVICE_HOST=company-service-opera:9022
CONFIG_SERVICE_ACCOUNTS_HOST=http://company-service-opera:9022

# Downstream services intentionally not present in integration-env
SNOWDROP_URL=http://snowdrop.not-in-integration-env.invalid
AV_CACHE_SERVICE_HOST=http://availability-cache-service-opera.not-in-integration-env.invalid
MIGRATION_SERVICE_HOST=http://hotel-migration-status-service.not-in-integration-env.invalid
PROMO_SERVICE_HOST=promo-service.not-in-integration-env.invalid
DYNAMICS_HOST=http://dynamics365.not-in-integration-env.invalid
CONFIG_SERVICE_OAUTH_CLIENT_HOST=http://microsoft-oauth.not-in-integration-env.invalid
OAUTH2_TENANT=/unused
OAUTH2_CLIENTID=unused
OAUTH2_CLIENTSECRET=unused

# Auth0/JWKS. Integration tests install the matching JWKS into WireMock CDH/Auth0.
CCUI_TENANT_ISSUER=https://mock-ccui-auth0-domain/
CCUI_TENANT_AUDIENCE=https://mock-ccui-auth0-audience/
CCUI_TENANT_NAMESPACE=https://mock-ccui
CCUI_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json
PI_BB_TENANT_ISSUER=https://mock-auth0-domain/
PI_BB_TENANT_AUDIENCE=https://mock-auth0-audience/api/v2/
PI_BB_TENANT_NAMESPACE=https://premierinn.com
PI_BB_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit

# Cache is deliberately disabled for the integration environment.
CACHE_TYPE=none

# Application configuration mirrored from the DIT Helm values.
COMPANY_ID=66471
CCUI_SRP_NEGOTIATED_RATE_ENABLED=false
ACC_AVAILABILITY_ROOM_TYPES=DOUBLE,LOWDBL,WETDBL,ZPLDBL,WETTWN,FMTHRE,FMFOUR,TWINRM,LOWTWN,VDOUBL,VPPDBL,VFMFOR,VFMTHR,DBLWIN,BIGWIN,ACCWIN,NWDSPL,WINCMB,NWDCMB,WINSPL,FMQUAD,FMTRPL,VFMTRP,VFMQUD
ACC_AVAILABILITY_RATES=FLEXRATE,NONFLEXD,FITRATE1
NON_MEAL_PACKAGE_IDS=HSCKIN,HSCOU2,FI24HR
PROMOTIONAL_RATE=PROBRKST
CUT_OFF_TIME=2
