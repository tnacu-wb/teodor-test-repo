# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-Xms64m -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5018 -Dlogging.level.uk.co.whitbread=DEBUG

# Cache is deliberately disabled for the integration environment.
CACHE_TYPE=none
MANAGEMENT_HEALTH_REDIS_ENABLED=false
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.data.redis.autoconfigure.DataRedisAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.DataRedisReactiveAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.DataRedisRepositoriesAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.health.DataRedisHealthContributorAutoConfiguration,org.springframework.boot.data.redis.autoconfigure.health.DataRedisReactiveHealthContributorAutoConfiguration

# Available downstream services
HOTEL_COUNTRIES_URL=http://hotel-countries-service-opera:9031
THREEC_PAYMENT_URL=http://threec-payment-service-opera:9001
CDH_ADAPTER_URL=http://cdh-adapter-service:9119
PIBA_ACCOUNT_URL=http://piba-account-service-opera:9064

# External systems use the existing local endpoints.
CDH_OAUTH_HOST=http://wiremock-cdh-auth0:8080
AZURE_OAUTH_CLIENT_TOKEN_URL=
CDH_API_HOST=http://wiremock-cdh-auth0:8080
PIBAGUID_URL=http://wiremock-worldline-datatrans:8080
WORLDLINE_HOST=http://wiremock-worldline-datatrans:8080
AUTH_MNGMT_DOMAIN=http://wiremock-cdh-auth0:8080
AZURE_PTI_EMAIL_HOST=http://wiremock-cdh-auth0:8080/internal/PTIEmailService/v1
AZURE_GENERIC_EMAIL_HOST=http://wiremock-cdh-auth0:8080/internal/EmailService/v1

# Auth0/JWKS
PI_BB_TENANT_ISSUER=https://mock-auth0-domain/
PI_BB_TENANT_AUDIENCE=https://mock-auth0-audience/api/v2/
PI_BB_TENANT_NAMESPACE=https://premierinn.com
PI_BB_TENANT_JWK_URI=http://wiremock-cdh-auth0:8080/.well-known/jwks.json
AUTH0_CLIENT_ID=unused
AUTH0_CLIENT_SECRET=unused
AUTH_MNGMT_AUDIENCE=https://mock-auth0-audience/api/v2/
AUTH_MNGMT_B2C_CONNECTION=unused-b2c
AUTH_MNGMT_B2B_CONNECTION=unused-b2b
AUTH_MNGMT_CONNECTION=unused
AUTH_MNGMT_IS_LAZY_MIGRATION_ENABLED=false
AUTH_RESET_PASSWORD_TOKEN_TTL_SEC=3600
AUTH_MNGMT_CUSTOM_DOMAIN=mock-auth0-domain

# CDH
AZURE_OAUTH_CLIENT_CLIENT_ID=unused
AZURE_OAUTH_CLIENT_CLIENT_SECRET=unused
CDH_OAUTH_SCOPE=unused
CDH_OAUTH_GRANT_TYPE=client_credentials
CDH_OAUTH_IS_ENABLED=true
CDH_IS_LAZY_MIGRATION_ENABLED=false
CDH_API_IS_OAUTH=true
ACCOUNT_SERVICES_OAUTH_SUBSCRIPTION_KEY=unused
BOOKING_HUB_OAUTH_SUBSCRIPTION_KEY=unused

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit

# Password policy
PASSWORDS_CONFIGS_ACCOUNT_MIN_LENGTH=8
PASSWORDS_CONFIGS_ACCOUNT_MAX_LENGTH=50
PASSWORDS_CONFIGS_ACCOUNT_ILLEGAL_CHARS=:~
PASSWORDS_CONFIGS_ACCOUNT_ALLOW_NULL=true
PASSWORDS_CONFIGS_ACCOUNT_AUTH_MIN_LENGTH=8
PASSWORDS_CONFIGS_ACCOUNT_AUTH_ALLOW_NULL=true

# Email and reset URLs
HOTEL_ACCOUNT_FORGOT_PASSWORD_URL=http://hotel-account-service-opera:9020/forgot-password
EMAIL_PI_RESET_PASSWORD_URL=http://hotel-account-service-opera:9020/reset-password
EMAIL_INN_BUSINESS_RESET_PASSWORD_URL=http://hotel-account-service-opera:9020/reset-password
EMAIL_INN_BUSINESS_RESET_PASSWORD_URL_DE=http://hotel-account-service-opera:9020/reset-password
LOGIN_DOMAIN_URL=http://hotel-account-service-opera:9020
AZURE_EMAIL_SERVICE_USERNAME=unused
AZURE_EMAIL_SERVICE_PASSWORD=unused
AZURE_EMAIL_SERVICE_SUBSCRIPTION_KEY=unused
AZURE_GENERIC_EMAIL_SERVICE_USERNAME=unused
AZURE_GENERIC_EMAIL_SERVICE_PASSWORD=unused
AZURE_GENERIC_EMAIL_SERVICE_SUBSCRIPTION_KEY=unused

# Worldline
WORLDLINE_USERNAME_GB=unused
WORLDLINE_PASSWORD_GB=unused
WORLDLINE_USERNAME_DE=unused
WORLDLINE_PASSWORD_DE=unused
