# Spring
SPRING_PROFILES_ACTIVE=opera-dit
JAVA_OPTS=-XX:InitialRAMPercentage=10 -XX:MaxRAMPercentage=80 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005 -Dlogging.level.uk.co.whitbread=DEBUG

# Opera OHIP connection (routed to WireMock Opera container)
OPERA_HOST=http://wiremock-opera:8080
OPERA_APP_KEY=mock-app-key
OPERA_CLIENT_ID=mock-client-id
OPERA_CLIENT_SECRET=mock-client-secret
OPERA_USERNAME=mock-username
OPERA_PASSWORD=mock-password
OPERA_AUTH_ENDPOINT=oauth/v1/tokens
OPERA_SCOPE=urn:opc:hgbu:ws:__myscopes__
OPERA_TOKEN_REFRESH_SKEW=15
ENABLE_CLIENT_CREDENTIALS=true
ENTERPRISE_ID=WHBPI

# Cache is disabled.
CACHE_TYPE=none

# Unleash
UNLEASH_URL=http://unleash:4242/api
UNLEASH_TOKEN=default:development.mock-unleash-token
UNLEASH_ENVIRONMENT=dit
INTEGRATION_TESTS_FEATURE_FLAG_OVERRIDES_ENABLED=true

# Service dependencies
RULES_AGENT_HOST=rules-agent-entity-service:9108
TOKEN_SERVICE_HOST=http://opera-token-service.not-in-integration-env.invalid

# Application config
WIRE_TAP_ACCESS_TOKEN=false
OVERRIDE_INSUFFICIENT_CC=true
NON_DIGITAL_PAYMENT_HOTELS=BANBRI,GATGAT,LONSTM,LONKIN,FRESUD,FRAMTI
PROMOTIONAL_RATE=PROBRKST
PROMOTIONAL_PACKAGE=OBFPRO
RESTRICTIONS_PARALLEL_THREADS=5
