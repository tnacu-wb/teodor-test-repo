{
  "name": "opera.oauth-token",
  "request": {
    "method": "POST",
    "url": "/oauth/v1/tokens"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "token",
      "expires_in": 3600,
      "token_type": "Bearer"
    }
  }
}
