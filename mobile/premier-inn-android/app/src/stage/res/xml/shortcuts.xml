<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Maybe remove this code for Find hotel shortcut, because it is not very useful with the new design -->
    <!-- To enable this shortcut, the code should be also updated to send selected search item to Landing activity -->
    <shortcut
        android:enabled="false"
        android:icon="@drawable/ic_search_shortcut"
        android:shortcutId="shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_hotel"
        android:shortcutLongLabel="@string/shortcut_search_hotel"
        android:shortcutDisabledMessage="@string/shortcut_search_hotel">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.whitbread.premierinn.landing.LandingActivity"
            android:targetPackage="com.whitbread.premierinn.stage"/>

        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.whitbread.premierinn.search.SearchActivity"
            android:targetPackage="com.whitbread.premierinn.stage"/>

        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_location"
        android:shortcutId="shortcut_my_location"
        android:shortcutShortLabel="@string/shortcut_hotels_near_me"
        android:shortcutLongLabel="@string/shortcut_hotels_near_me"
        android:shortcutDisabledMessage="@string/shortcut_hotels_near_me">

        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.whitbread.premierinn.landing.LandingActivity"
            android:targetPackage="com.whitbread.premierinn.stage"/>

        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.whitbread.premierinn.shortcutlocationtrampoline.ShortcutLocationTrampolineActivity"
            android:targetPackage="com.whitbread.premierinn.stage"/>

        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>