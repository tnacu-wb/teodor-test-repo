<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <stroke android:width="2dp" android:color="@color/metallic_pearl_seventy_percent" />
            <solid android:color="@color/metallic_pearl_seventy_percent" />
        </shape>
    </item>
    <item android:drawable="@drawable/btn_outline" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <stroke android:width="2dp" android:color="@color/metallic_pearl_seventy_percent" />
            <solid android:color="@color/metallic_pearl_seventy_percent" />
        </shape>
    </item>

    <item android:drawable="@drawable/btn_outline" />

</selector>