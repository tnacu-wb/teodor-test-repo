<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    android:animateLayoutChanges="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:fitsSystemWindows="true"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/amend_guest_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/amend_guests_scroll_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintVertical_weight="1" />

    <ScrollView
        android:id='@+id/amend_guests_scroll_view'
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/generic_margin_15"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingBottom="@dimen/generic_padding_64"
            android:paddingTop="@dimen/generic_padding_50">

            <FrameLayout
                android:id="@+id/amend_edit_error_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/red"
                android:paddingStart="@dimen/generic_padding_16"
                android:paddingTop="@dimen/generic_padding_12"
                android:paddingEnd="@dimen/generic_padding_16"
                android:paddingBottom="@dimen/generic_padding_12"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/amend_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/BodySmallSemiBold"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/generic_margin_12"
                    android:gravity="center"
                    android:textColor="@color/white"
                    tools:text="No more Family Rooms available at this hotel" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/amend_guests_rooms_fragment_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Amend Dates Layout -->

            <com.whitbread.premierinn.common.view.InfoMessageBoxView
                android:id="@+id/amend_added_room_criteria_summary_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/generic_margin_16"
                android:background="@drawable/shape_grey_stroke_white_background"
                android:padding="@dimen/generic_padding_16"
                android:src="@drawable/ic_info"
                android:minLines="3"
                app:iconTintColor="@color/teal"
                android:visibility="gone" />

            <include
                android:id="@+id/amend_added_room_criteria_summary"
                layout="@layout/view_room_criteria_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/default_medium_margin"
                android:visibility="gone" />

            <include
                android:id="@+id/amend_added_room_lead_guest"
                layout="@layout/view_lead_guest_details"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/amend_guests_lead_guests_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/generic_margin_8"
                android:padding="@dimen/generic_padding_24">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Header2"
                    android:paddingBottom="@dimen/generic_padding_16"
                    android:text="@string/amend_lead_guest" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/titles_spinner"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whitbread.premierinn.common.view.FormEditTextView
                    android:id="@+id/first_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:hint="@string/guest_details_form_first_name"
                    android:imeOptions="actionNext"
                    android:inputType="textCapWords|textNoSuggestions" />

                <com.whitbread.premierinn.common.view.FormEditTextView
                    android:id="@+id/last_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:hint="@string/guest_details_form_last_name"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords|textNoSuggestions" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/amend_guests_button_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:background="@color/white"
        android:paddingStart="@dimen/generic_padding_24"
        android:paddingTop="@dimen/generic_padding_16"
        android:paddingEnd="@dimen/generic_padding_24"
        android:paddingBottom="@dimen/generic_padding_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="0">

        <com.whitbread.premierinn.common.view.CallToActionButtonLayout
            android:id="@+id/amend_guests_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            style="@style/Button1"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/update_button" />

        <com.whitbread.premierinn.common.view.CallToActionButtonLayout
            android:id="@+id/add_guest_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            style="@style/Button1"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/button_text_continue"
            android:visibility="gone"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>