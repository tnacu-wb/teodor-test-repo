<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/total_booking_label"
        style="@style/Header2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_35"
        android:text="@string/total_booking_label" />

    <TextView
        android:id="@+id/total_booking_price"
        style="@style/Header2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/total_booking_label"
        android:layout_alignParentEnd="true"
        tools:text="£125.00" />

    <TextView
        android:id="@+id/total_booking_city_tax_incl_message"
        style="@style/BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/total_booking_label"
        android:layout_alignEnd="@id/total_booking_price"
        android:paddingBottom="@dimen/generic_padding_1"
        android:text="@string/review_booking_taxes_and_fees_message"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/booking_rate_label"
        style="@style/BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/total_booking_city_tax_incl_message"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/generic_margin_5"
        android:layout_marginEnd="@dimen/generic_margin_5"
        android:layout_toStartOf="@+id/booking_rate_name"
        android:paddingBottom="@dimen/generic_padding_1"
        android:text="@string/rate_label"
        android:visibility="visible"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/booking_rate_name"
        style="@style/Header4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/total_booking_city_tax_incl_message"
        android:layout_alignEnd="@id/total_booking_price"
        android:layout_alignParentBottom="true"
        android:textColor="@color/teal"
        tools:text="Flex" />

</merge>