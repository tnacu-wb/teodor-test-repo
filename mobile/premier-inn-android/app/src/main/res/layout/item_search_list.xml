<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_item_height"
    android:background="@drawable/item_search_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/generic_padding_24"
        android:paddingEnd="@dimen/generic_padding_24"
        tools:context=".search.SearchActivity">

        <ImageView
            android:id="@+id/recent_search_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:src="@drawable/ic_hotel_purple" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/place_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lines="1"
                android:textColor="@color/grey_dark"
                style="@style/Body"
                tools:text="Wetherspoons" />

            <TextView
                android:id="@+id/hotel_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_results_hotel_label"
                android:textColor="@color/grey_medium"
                style="@style/Body" />
        </LinearLayout>


    </LinearLayout>
</FrameLayout>
