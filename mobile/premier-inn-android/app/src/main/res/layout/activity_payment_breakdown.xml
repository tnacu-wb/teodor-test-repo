<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:gravity="center"
        android:title="@string/payment_breakdown_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.whitbread.premierinn.common.view.PriceBreakdownView
                android:id="@+id/pbv_payment_breakdown_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_40" />

            <include layout="@layout/layout_breakdown_extras"
                android:id="@+id/layout_breakdown_extras"/>

            <com.whitbread.premierinn.common.view.SummaryExpensesView
                android:id="@+id/payment_breakdown_cc_processing_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/generic_margin_16"
                android:layout_marginEnd="@dimen/generic_margin_16"
                android:layout_marginBottom="@dimen/generic_margin_20"
                android:visibility="gone" />

            <com.whitbread.premierinn.common.view.TotalPriceView
                android:id="@+id/payment_breakdown_total_price_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/generic_margin_16"
                android:layout_marginEnd="@dimen/generic_margin_16"
                android:paddingBottom="@dimen/generic_padding_100" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>