<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/generic_padding_24"
    tools:background="@color/premier_inn_purple">

    <TextView
        android:id="@+id/bart_down_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight=".2"
        android:gravity="center"
        android:textColor="@color/white"
        style="@style/Header1"
        tools:text="@string/bart_down_maintenance_title" />

    <TextView
        android:id="@+id/bart_down_description"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".3"
        android:lineSpacingMultiplier="1.2"
        android:textAlignment="center"
        android:textColor="@color/white"
        style="@style/Body"
        tools:text="@string/bart_down_maintenance_description" />
    <TextView
        android:id="@+id/bart_down_make_booking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".2"
        android:lineSpacingMultiplier="1.2"
        android:textAlignment="center"
        android:textColor="@color/white"
        style="@style/Body"
        tools:text="@string/bart_down_maintenance_make_booking_text" />

    <TextView
        android:id="@+id/bart_down_existing_booking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight=".4"
        android:lineSpacingMultiplier="1.2"
        android:textAlignment="center"
        android:textColor="@color/white"
        style="@style/Body"
        tools:text="@string/bart_down_maintenance_existing_booking_text" />


</LinearLayout>