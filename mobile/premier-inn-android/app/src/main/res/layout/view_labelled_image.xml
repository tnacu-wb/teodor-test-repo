<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <com.whitbread.premierinn.common.view.NetworkImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/roundel"
        android:layout_width="80dp"
        android:layout_height="80dp"
        style="@style/SubtextSmallSemiBold"
        android:layout_marginTop="@dimen/generic_margin_30"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:layout_gravity="end"
        android:src="@drawable/ic_arrow_back_white_in_circle"
        tools:text="Hub\nStandard Rooms"
        android:background="@drawable/roundel_base"
        android:backgroundTint="@color/grey"
        android:gravity="center"
        android:textColor="@color/white"
        android:textAllCaps="true"
        android:visibility="gone"
        tools:visibility="visible"/>
</merge>

