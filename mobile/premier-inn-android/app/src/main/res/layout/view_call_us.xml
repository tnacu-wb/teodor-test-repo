<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:showIn="@layout/view_hotel_details_call_us">

    <ImageView
        android:id="@+id/view_call_us_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/icon_call" />

    <TextView
        android:id="@+id/view_call_us_label"
        style="@style/Header3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:text="@string/call_us"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/view_call_us_description"
        style="@style/SubtextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:gravity="center"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        tools:text="@string/call_view_cost" />


</merge>
