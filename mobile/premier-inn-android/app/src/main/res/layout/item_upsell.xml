<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/generic_margin_4"
    android:background="@drawable/booking_pre_stay_details_card_shape"
    android:padding="@dimen/generic_padding_16"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <com.whitbread.premierinn.common.view.ShapeableNetworkImageView
        android:id="@+id/item_upsell_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CornerRounded8" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/item_upsell_image"
        app:layout_constraintTop_toTopOf="@id/item_upsell_image">

        <TextView
            android:id="@+id/item_upsell_name"
            style="@style/Header2Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1sp"
            tools:text="Menu" />

        <TextView
            android:id="@+id/itemUpsellDescription"
            style="@style/BodySmallRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_grey_2"
            tools:text="$10 per adult/day" />

        <TextView
            android:id="@+id/upsellInfoTextView"
            style="@style/BodySmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_4"
            android:background="@drawable/upsell_info_background"
            android:maxLines="2"
            android:paddingHorizontal="@dimen/generic_padding_8"
            android:paddingVertical="@dimen/generic_padding_4"
            android:textSize="@dimen/subtext_text_size_13"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
