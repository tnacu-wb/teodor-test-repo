<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:background="@color/white"
    android:paddingTop="@dimen/generic_padding_16"
    android:paddingBottom="@dimen/generic_padding_16">

    <TextView
        android:id="@+id/payment_type_Lbl"
        style="@style/Header3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:text="@string/payment_type"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Payment type" />

    <LinearLayout
        android:id="@+id/paymentInformationHolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/payment_type_Lbl"
        app:layout_constraintTop_toBottomOf="@+id/payment_type_Lbl"
        tools:layout_height="50dp"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/paymentTypeHolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:background="@drawable/rectangular_grey_left_right_bottom_bordered_background"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/payment_type_Lbl"
        app:layout_constraintTop_toBottomOf="@+id/paymentInformationHolder">
        
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bookingPayOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:animateLayoutChanges="true"
        android:background="@android:color/white"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/paymentTypeHolder"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/paymentTimingToggleHolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:orientation="vertical"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_review_booking_title"
                style="@style/Header3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/review_booking_pay_choice_title"
                android:textColor="?attr/colorPrimary" />

            <com.whitbread.premierinn.common.view.ToggleButtonView
                android:id="@+id/bookingPayNowLaterToggle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/generic_margin_8"
                app:tbv_start_selected="true"
                app:tbv_text_left="@string/review_booking_button_label_pay_arrival"
                app:tbv_text_right="@string/review_booking_button_label_pay_now" />
        </LinearLayout>

        <com.whitbread.premierinn.common.view.InfoMessageBoxView
            android:id="@+id/bookingPaymentTimingBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:animateLayoutChanges="true"
            android:background="@drawable/information_notification_background"
            android:paddingStart="@dimen/generic_padding_16"
            android:paddingTop="@dimen/generic_padding_12"
            android:paddingEnd="@dimen/generic_padding_16"
            android:paddingBottom="@dimen/generic_padding_12"
            android:src="@drawable/ic_info"
            app:iconTintColor="@color/information_blue" />
    </LinearLayout>

    <com.whitbread.premierinn.reviewbooking.PIBAPaymentComponent
        android:id="@+id/pibaDetailsHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/bookingPayOptions"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>


    <com.whitbread.premierinn.common.view.CardHolderAddressComponentView
        android:id="@+id/cardHolderAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@+id/bookingPayOptions"
        app:layout_constraintStart_toStartOf="@+id/bookingPayOptions"
        app:layout_constraintTop_toBottomOf="@+id/pibaDetailsHolder"
        tools:layout_height="50dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

