<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/footerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/light_grey_5">

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressDrawable="@drawable/pre_stay_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/priceBreakdownSummaryContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/priceBreakdownArrowImageView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/generic_margin_4"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="#333333" />

            <TextView
                android:id="@+id/totalPriceTextView"
                style="@style/Header2ExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="$300.89" />
        </LinearLayout>

        <TextView
            android:id="@+id/priceBreakdownDescriptionTextView"
            style="@style/Header4Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price_breakdown_summary_text"
            android:textColor="@color/teal_dark" />

    </LinearLayout>

    <com.whitbread.premierinn.common.view.CallToActionButtonLayout
        android:id="@+id/continueButton"
        style="@style/Button1"
        android:layout_width="wrap_content"
        android:minWidth="156dp"
        android:layout_height="54dp"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:paddingHorizontal="@dimen/generic_margin_15"
        android:text="@string/button_text_continue"
        app:cab_spinner_color="@color/white"
        app:cab_text_color="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <View
        android:id="@+id/priceBreakdownDetailsSeparator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:background="@color/full_black_10"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/continueButton" />

    <LinearLayout
        android:id="@+id/priceBreakdownDetailedViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/generic_margin_16"
        android:orientation="vertical"
        android:paddingBottom="@dimen/generic_padding_8"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/priceBreakdownDetailsSeparator" />

</androidx.constraintlayout.widget.ConstraintLayout>
