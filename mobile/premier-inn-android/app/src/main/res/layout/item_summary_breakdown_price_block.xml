<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/metallic_pearl_eighty_percent"
                android:padding="@dimen/generic_padding_10">

    <TextView
        android:id="@+id/tv_summary_breakdown_price_block_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Body"
        android:layout_alignBaseline="@+id/tv_summary_breakdown_price_block_price"
        android:textColor="?attr/colorPrimary"
        tools:text="Mon 12th Sep"/>

    <TextView
        android:id="@id/tv_summary_breakdown_price_block_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Header2"
        android:gravity="end"
        tools:text="£219.00"/>

</RelativeLayout>