<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/generic_corner_radius_2">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/generic_padding_16">

        <com.whitbread.premierinn.common.view.NetworkImageView
            android:id="@+id/search_result_hotel_image"
            android:layout_width="match_parent"
            android:layout_height="242dp"
            android:layout_alignParentTop="true"
            android:scaleType="centerCrop"
            app:ivp_zoomOutPageTransformer="true" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_badges"
            android:orientation="horizontal">
        <TextView
            android:id="@+id/search_result_label"
            style="@style/Header4"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_margin="@dimen/generic_margin_16"
            android:paddingStart="@dimen/generic_padding_8"
            android:layout_gravity="start"
            android:paddingEnd="@dimen/generic_padding_8"
            android:textColor="@android:color/white"
            android:visibility="gone"
            tools:text="@string/search_results_item_new_hotel"
            tools:textColor="@android:color/black"
            tools:visibility="visible" />

            <TextView
                android:id="@+id/employee_rate_label"
                style="@style/Header4"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_margin="@dimen/generic_margin_16"
                android:layout_alignParentEnd="true"
                android:paddingStart="@dimen/generic_padding_8"
                android:paddingEnd="@dimen/generic_padding_8"
                android:textColor="@android:color/white"
                android:visibility="gone"
                android:background="@drawable/rounded_corner_blue_2dp"

                tools:text="@string/search_results_employee_discount"
                tools:textColor="@android:color/black"
                tools:visibility="visible" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/searchresult_rate_layout"
            android:layout_width="125dp"
            android:layout_height="60dp"
            android:layout_alignBottom="@id/search_result_hotel_image"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="@dimen/generic_margin_20"
            android:background="@drawable/search_results_rate_background"
            android:elevation="@dimen/generic_elevation_2"
            android:orientation="vertical"
            android:paddingStart="@dimen/generic_padding_16"
            android:paddingEnd="0dp">

            <TextView
                style="@style/Subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="@dimen/generic_margin_8"
                android:text="@string/prices_from" />

            <TextView
                android:id="@+id/search_result_price"
                style="@style/Header2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/generic_margin_8"
                tools:text="£1020.75" />

        </RelativeLayout>

        <TextView
            android:id="@+id/search_result_hotel_name"
            style="@style/Header3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/search_result_hotel_image"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_16"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:textColor="?attr/colorPrimary"
            tools:text="hub by Premier Inn - London Spitalfields, Brick Lane" />

        <TextView
            android:id="@+id/search_result_last_few_rooms_label"
            style="@style/BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/search_result_hotel_name"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_10"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:text="@string/search_results_item_last_few_rooms"
            android:textColor="?attr/urgentHighlightColor"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/search_result_distance"
            style="@style/Subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/search_result_last_few_rooms_label"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_10"
            android:layout_marginEnd="@dimen/generic_margin_16"
            tools:text="0.2 miles from your search location" />

        <com.whitbread.premierinn.common.view.TripAdvisorView
            android:id="@+id/search_results_trip_advisor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/search_result_distance"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_10" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/search_result_distance"
            android:layout_marginStart="@dimen/generic_margin_28"
            android:layout_marginTop="@dimen/generic_margin_10"
            android:layout_marginEnd="@dimen/generic_margin_10"
            android:layout_toEndOf="@id/search_results_trip_advisor"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/search_result_parking_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_free_parking"
                android:tint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/search_result_parking_description"
                style="@style/SubtextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/generic_margin_5"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="chargeable onsite parking"
                tools:visibility="visible" />

        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>