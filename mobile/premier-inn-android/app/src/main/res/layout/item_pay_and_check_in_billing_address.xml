<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <TextView
        android:id="@+id/billingAddressTitle"
        style="@style/Header2ExtraBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/billing_address"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/billingAddressInfo"
        style="@style/Header4Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:text="@string/same_as_booker_address_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/billingAddressTitle" />

    <TextView
        android:id="@+id/billingAddressCode"
        style="@style/Header4Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/billingAddressInfo"
        tools:text="EC27MC" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/billingAddressSwitchCompat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:thumb="@drawable/ic_switch_thumb"
        app:layout_constraintBottom_toBottomOf="@id/billingAddressCode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/billingAddressInfo"
        app:track="@drawable/ic_switch_track" />

</androidx.constraintlayout.widget.ConstraintLayout>
