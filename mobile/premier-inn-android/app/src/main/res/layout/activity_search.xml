<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".search.SearchActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:clipToPadding="false">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/generic_margin_8"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:layout_marginLeft="@dimen/generic_margin_16"
            android:layout_marginRight="@dimen/generic_margin_16"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:transitionName="@string/search_bar_transition"
            app:cardCornerRadius="@dimen/generic_corner_radius_2"
            app:cardElevation="@dimen/generic_elevation_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_search_back_arrow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center|start"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="false"
                    android:padding="@dimen/generic_padding_12"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="?attr/colorPrimary" />

                <EditText
                    android:id="@+id/et_layout_search"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/generic_margin_8"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:textColor="@color/mine_shaft"
                    android:hint="@string/search_bar_hint_text"
                    style="@style/Body"
                    android:inputType="text"
                    android:maxLines="1" />

                <ProgressBar
                    android:id="@+id/search_progress_loading"
                    android:layout_width="@dimen/toolbar_progress_bar_width"
                    android:layout_height="@dimen/toolbar_progress_bar_height"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/generic_margin_8"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/search_clear"
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/generic_margin_8"
                    android:src="@drawable/ic_close"
                    android:tint="@color/grey_dark"
                    android:background="@null"
                    android:visibility="invisible"
                    tools:visibility="visible" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/no_internet_message_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_search_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/metallic_pearl_eighty_percent" />

        <LinearLayout
            android:id="@+id/ll_search_no_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/generic_padding_24"
            android:paddingEnd="@dimen/generic_padding_24"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/no_search_results_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="No results found"
                style="@style/Header4"
                android:textColor="@color/grey_dark"/>

            <TextView
                android:id="@+id/no_search_results_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_20"
                android:gravity="center"
                android:text="@string/search_activity_no_results_descriptive_message"
                style="@style/Body"
                android:textColor="@color/grey_dark"/>

        </LinearLayout>

    </FrameLayout>
</LinearLayout>
