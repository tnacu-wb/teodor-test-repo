<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:minHeight="?attr/actionBarSize" />

    <FrameLayout
        android:id="@+id/booking_details_error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/red"
        android:paddingStart="@dimen/generic_padding_12"
        android:paddingTop="@dimen/generic_padding_12"
        android:paddingEnd="@dimen/generic_padding_12"
        android:paddingBottom="@dimen/generic_padding_12"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BodySmallSemiBold"
            android:layout_gravity="center"
            android:layout_margin="@dimen/generic_margin_8"
            android:gravity="center"
            android:textColor="@color/white"
            android:text="@string/booking_details_error_banner_message"
            tools:text="We were unable to retrieve the latest information for your booking so this information may be out of date" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/amend_confirm_changes_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/teal_dark"
        android:padding="@dimen/generic_padding_4"
        android:visibility="gone"
        tools:visibility="visible">

        <com.whitbread.premierinn.common.view.InfoMessageBoxView
            android:id="@+id/amend_confirm_changes_banner_infoMessageBoxView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BodySmallSemiBold"
            android:gravity="center_vertical"
            android:padding="@dimen/generic_padding_14"
            android:src="@drawable/notifications_success"
            android:textColor="@color/white"
            android:visibility="gone"
            tools:text="Your booking has been updated, please pay £XX.XX upon arrival"
            tools:visibility="visible" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/generic_padding_16">

            <com.whitbread.premierinn.common.view.InfoMessageBoxView
                android:id="@+id/booking_details_payment_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="@dimen/generic_padding_16"
                android:src="@drawable/notifications_success"
                android:textColor="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/generic_padding_24"
                android:paddingEnd="@dimen/generic_padding_24">

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/booking_details_info_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_20"
                    android:layout_marginBottom="@dimen/generic_margin_4"
                    android:background="@drawable/shape_grey_stroke_white_background"
                    android:padding="@dimen/generic_padding_16"
                    android:paddingBottom="@dimen/generic_padding_18"
                    android:src="@drawable/ic_info"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:iconTintColor="@color/teal" />

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/booking_amend_info_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_20"
                    android:layout_marginBottom="@dimen/generic_margin_4"
                    android:background="@drawable/information_notification_background"
                    android:padding="@dimen/generic_padding_16"
                    android:paddingBottom="@dimen/generic_padding_18"
                    android:src="@drawable/ic_info"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:iconTintColor="@color/information_blue"
                     />

                <RelativeLayout
                    android:id="@+id/booking_details_hotel_name_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="@dimen/generic_padding_4"
                    android:paddingBottom="@dimen/generic_padding_4">

                    <TextView
                        android:id="@+id/booking_status"
                        style="@style/BodySmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="@dimen/generic_margin_16"
                        android:background="@drawable/shape_light_green_stroke"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/generic_padding_8"
                        android:paddingVertical="@dimen/generic_padding_4"
                        android:textColor="@color/success_green"
                        android:visibility="gone"
                        tools:text="Checked-in"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/booking_details_going_to_label"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/booking_status"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:text="@string/booking_details_you_are_going_to" />

                    <TextView
                        android:id="@+id/booking_details_hotel_name"
                        style="@style/Header1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/booking_details_going_to_label"
                        android:layout_toStartOf="@+id/iv_booking_details_chevron"
                        tools:text="London kings Cross" />

                    <ImageView
                        android:id="@+id/iv_booking_details_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_below="@+id/booking_details_going_to_label"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorPrimary" />
                </RelativeLayout>


                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/booking_details_city_tax_info_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_16"
                    android:background="@drawable/shape_grey_stroke_white_background"
                    android:gravity="center"
                    android:padding="@dimen/generic_padding_16"
                    android:src="@drawable/ic_info"
                    android:visibility="gone"
                    app:iconTintColor="@color/premier_inn_purple"
                    tools:text="@string/booking_details_business_city_tax_info_message"
                    tools:visibility="visible" />

                <RelativeLayout
                    android:id="@+id/booking_reference_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/booking_reference_header"
                        style="@style/Header4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:text="@string/booking_reference"
                        android:textColor="@color/teal" />

                    <TextView
                        android:id="@+id/send_invoice"
                        style="@style/Action1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/booking_reference_header"
                        android:layout_alignBottom="@+id/booking_details_reference"
                        android:layout_alignParentEnd="true"
                        android:gravity="center_vertical"
                        android:text="@string/send_invoice"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/booking_details_reference"
                        style="@style/Header1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/booking_reference_header"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/send_invoice" />
                </RelativeLayout>

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/invoiceSendMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_10"
                    android:padding="@dimen/generic_padding_16"
                    android:src="@drawable/ic_info"
                    android:textColor="@color/grey_dark"
                    android:visibility="gone"
                    tools:background="@drawable/shape_error_red_background"
                    tools:iconTintColor="@color/new_error_red"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_20"
                    android:background="@color/mint_dark_fifty_percent" />

                <TextView
                    style="@style/Header4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_5"
                    android:text="@string/booking_details_your_trip"
                    android:textColor="@color/teal" />

                <TextView
                    android:id="@+id/booking_details_guest_room"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_5" />

                <TextView
                    android:id="@+id/booking_details_nights"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_5" />

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/booking_details_employee_privilege_card_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/generic_margin_6"
                    android:paddingTop="@dimen/generic_margin_16"
                    android:paddingBottom="@dimen/generic_margin_12"
                    android:paddingStart="@dimen/generic_margin_16"
                    android:paddingEnd="@dimen/generic_margin_16"
                    android:background="@drawable/alert_notification_background"
                    android:src="@drawable/notifications_alert"
                    android:text="@string/booking_details_employee_privilege_card_message"
                    tools:text="@string/booking_details_employee_privilege_card_message"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/generic_margin_25"
                    android:background="@color/mint_dark_fifty_percent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_20"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Header4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:layout_weight="1"
                        android:text="@string/booking_details_arriving"
                        android:textColor="@color/teal" />

                    <TextView
                        style="@style/Header4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:layout_weight="1"
                        android:text="@string/booking_details_leaving"
                        android:textColor="@color/teal" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/booking_details_date_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/booking_details_check_in_date"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/booking_details_check_out_date"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_20"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Body"
                        android:id="@+id/booking_details_check_in_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:layout_weight="1"/>

                    <TextView
                        style="@style/Body"
                        android:id="@+id/booking_details_check_out_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/generic_margin_16"
                        android:layout_marginBottom="@dimen/generic_margin_5"
                        android:layout_weight="1" />

                </LinearLayout>

                <com.whitbread.premierinn.common.view.CallToActionButtonLayout
                    android:id="@+id/booking_details_ciol_button"
                    style="@style/Button1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_6"
                    android:text="@string/booking_details_check_in_online"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:cab_text_color="@android:color/white" />

                <com.whitbread.premierinn.common.view.CallToActionButtonLayout
                    android:id="@+id/booking_details_ready_to_leave_button"
                    style="@style/Button1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_6"
                    android:text="@string/booking_details_ready_to_leave_button_text"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:cab_text_color="@android:color/white" />

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/booking_eci_lco_infobox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_20"
                    android:background="@drawable/information_notification_background"
                    android:padding="@dimen/generic_padding_16"
                    android:paddingBottom="@dimen/generic_padding_18"
                    android:src="@drawable/ic_info"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:iconTintColor="@color/information_blue"
                    />

                <TextView
                    android:id="@+id/booking_details_add_to_calendar_button"
                    style="@style/BookingDetailsButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="@dimen/generic_margin_30"
                    android:text="@string/booking_details_add_to_calendar"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/generic_margin_20"
                    android:background="@color/mint_dark_fifty_percent" />

                <TextView
                    style="@style/Header4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/generic_margin_5"
                    android:text="@string/booking_details_location"
                    android:textColor="@color/teal" />

                <TextView
                    android:id="@+id/booking_details_address"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="15 bath Rd, Houndslow, London, TW6 2AB" />

                <TextView
                    android:id="@+id/booking_details_direction_button"
                    style="@style/BookingDetailsButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/generic_margin_30"
                    android:layout_marginBottom="@dimen/generic_margin_30"
                    android:text="@string/booking_details_directions"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.whitbread.premierinn.common.view.MapView
                    android:id="@+id/booking_details_map"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginStart="@dimen/map_margin"
                    android:layout_marginEnd="@dimen/map_margin"
                    app:mv_buttonResetEnabled="false"
                    app:mv_rotateGesturesEnabled="false"
                    app:mv_scrollGesturesEnabled="false"
                    app:mv_zoomControlsEnabled="false"
                    app:mv_zoomGesturesEnabled="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_10"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/booking_details_parking_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_free_parking"
                        android:tint="?attr/colorPrimary"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/booking_details_parking_description"
                        style="@style/SubtextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/generic_margin_5"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone"
                        tools:text="chargeable onsite parking"
                        tools:visibility="visible" />

                </LinearLayout>

                <TextView
                    android:id="@+id/extras_header"
                    style="@style/Header4Bold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_16"
                    android:text="@string/extras_header"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/extras_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/generic_margin_minus_20"
                    android:layout_marginEnd="@dimen/generic_margin_minus_20"
                    android:background="@color/grey_light" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/generic_padding_24"
                    android:paddingBottom="@dimen/generic_padding_24">

                    <com.whitbread.premierinn.common.view.BalanceOutstandingView
                        android:id="@+id/booking_details_balance_outstanding_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/generic_margin_minus_26"
                        android:layout_marginBottom="@dimen/generic_margin_minus_26"/>

                    <com.whitbread.premierinn.common.view.TotalPriceView
                        android:id="@+id/booking_details_price_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/booking_details_balance_outstanding_container"/>

                    <View
                        android:id="@+id/booking_details_total_cost_separator"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@+id/booking_details_price_container"
                        android:layout_marginStart="@dimen/generic_margin_minus_21"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:layout_marginEnd="@dimen/generic_margin_minus_21"
                        android:background="@color/grey_light" />

                    <RelativeLayout
                        android:id="@+id/booking_details_price_breakdown_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/booking_details_total_cost_separator"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/booking_details_price_breakdown" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginTop="@dimen/generic_margin_24"
                            android:layout_marginBottom="@dimen/generic_margin_24"
                            android:src="@drawable/ic_arrow_pointing_right" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_alignParentBottom="true"
                            android:background="@color/grey_light" />
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>

            <ViewStub
                android:id="@+id/accessibility_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:layout="@layout/view_booking_details_accessibility_panel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/booking_details_your_trip"
                    style="@style/Header3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginTop="@dimen/generic_margin_40"
                    android:text="@string/booking_details_your_trip" />

                <View
                    android:id="@+id/booking_details_separator_your_trip"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/generic_margin_40"
                    android:background="@color/grey_light" />

                <RelativeLayout
                    android:id="@+id/booking_details_manage_booking_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/booking_details_manage_booking"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:text="@string/manage_booking" />

                    <TextView
                        android:id="@+id/booking_details_manage_booking_sub_title"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/booking_details_manage_booking"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:layout_marginTop="@dimen/generic_margin_2"
                        android:text="@string/booking_details_amend_cancel_booking"
                        android:textColor="@color/grey" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/generic_margin_16"
                        android:src="@drawable/ic_arrow_pointing_right" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/booking_details_manage_booking_sub_title"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:background="@color/grey_light" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_bookings_details_faq_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tv_booking_details_faq"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:text="@string/booking_details_frequently_asked_questions" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/generic_margin_16"
                        android:src="@drawable/ic_arrow_pointing_right" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/tv_booking_details_faq"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:background="@color/grey_light" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_bookings_details_room_key_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/bookings_details_room_key_instructions"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:text="@string/booking_details_get_room_key_instructions" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/generic_margin_16"
                        android:src="@drawable/ic_arrow_pointing_right" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/bookings_details_room_key_instructions"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:background="@color/grey_light" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/booking_details_parking_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/bookings_details_parking_text_view"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:text="@string/booking_details_parking_text" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/generic_margin_16"
                        android:src="@drawable/ic_arrow_pointing_right" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/bookings_details_parking_text_view"
                        android:layout_marginTop="@dimen/generic_margin_24"
                        android:background="@color/grey_light" />
                </RelativeLayout>
            </LinearLayout>

            <com.whitbread.premierinn.criteria.view.CallUsView
                android:id="@+id/booking_details_call_us_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:paddingBottom="@dimen/generic_padding_16"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>

    <FrameLayout
        android:id="@+id/booking_details_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/booking_details_loading_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>