<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="@dimen/generic_padding_16"
    android:scrollbarStyle="outsideOverlay"
    android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/firstNameTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/lastNameTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/addressLine1TextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/addressLine2TextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/addressLine3TextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/postcodeTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/dateOfBirthLayout"
            layout="@layout/reg_card_date_of_birth_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/cityTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/countryTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <include
            android:id="@+id/nationalityTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/passportNumberTextInput"
            layout="@layout/reg_card_text_input_layout_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
