<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:visibility="visible">

    <TextView
        android:id="@+id/business_account_card_Lbl"
        style="@style/BodySemiBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_24"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:text="@string/business_account_card"
        tools:text="@string/business_account_card" />

    <TextView
        android:id="@+id/business_account_card_description"
        style="@style/Header3Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginEnd="@dimen/generic_margin_64"
        android:visibility="gone"
        tools:text="@string/business_account_card_euro_description" />

    <com.whitbread.premierinn.common.view.NetworkImageView
        android:id="@+id/businessAccountImage"
        android:layout_width="32dp"
        android:layout_height="22dp"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_16"
        android:layout_marginBottom="@dimen/generic_margin_24" />
</LinearLayout>
