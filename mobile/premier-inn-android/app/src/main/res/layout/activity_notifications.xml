<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premier_inn_purple">

    <ScrollView
        android:id="@+id/scroll_view_notifications"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/generic_margin_8"
        app:layout_constraintBottom_toTopOf="@+id/notification_accept_button_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/notification_title"
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_24"
                android:layout_marginBottom="@dimen/generic_margin_8"
                android:paddingStart="@dimen/generic_padding_24"
                android:paddingEnd="@dimen/generic_padding_24"
                android:paddingBottom="@dimen/generic_padding_24"
                android:text="@string/gdpr_message_title"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/notification_body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/string_notification_title"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/notification_body"
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_8"
                android:gravity="start"
                android:letterSpacing="0.01"
                android:paddingStart="@dimen/generic_padding_24"
                android:paddingEnd="@dimen/generic_padding_24"
                android:textColor="@color/white"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/notification_title"
                tools:text="In order to comply with the latest Government guidelines, we are asking you to cancel online any bookings you may have for stays up to and including 14th April 2020 unless the booking is for a key worker.\nFollowing the Government advice on COVID-19, we have temporarily closed the majority of our Premier Inn, hub and Zip hotels. A select number of hotels are currently open for sale for the exclusive use of key workers. We also have groups staying with us in a number of other locations. The remaining hotels have been removed for bookings, up to and including 30th April 2020. We will continue to review the support required on an ongoing basis and will provide updates in our COVD-19 page, which you can access via the link on My Account"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <com.whitbread.premierinn.common.view.CallToActionButtonLayout
        android:id="@+id/notification_accept_button_text"
        style="@style/Button1"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="@dimen/generic_margin_24"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/generic_padding_24"
        android:paddingTop="@dimen/generic_padding_8"
        android:paddingEnd="@dimen/generic_padding_24"
        android:paddingBottom="@dimen/generic_padding_8"
        android:layout_marginStart="@dimen/generic_margin_24"
        android:layout_marginEnd="@dimen/generic_margin_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="@string/button_text_continue" />

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/notification_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/generic_margin_8"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>