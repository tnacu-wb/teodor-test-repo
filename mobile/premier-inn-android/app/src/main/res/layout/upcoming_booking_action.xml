<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout"
    android:background="?android:selectableItemBackground">

    <TextView
        android:id="@+id/upcoming_booking_action_text"
        style="@style/Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry."
        android:ellipsize="end"
        app:layout_constraintEnd_toStartOf="@id/upcoming_booking_action_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/upcoming_booking_action_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:src="@drawable/ic_navigation_chevron_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/upcoming_booking_action_text"
        app:layout_constraintBottom_toBottomOf="@id/upcoming_booking_action_text"/>

</merge>