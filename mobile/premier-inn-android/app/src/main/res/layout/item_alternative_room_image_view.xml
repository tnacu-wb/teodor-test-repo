<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.whitbread.premierinn.common.view.NetworkImageView
        android:id="@+id/alternative_room_image_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/generic_margin_4"
        android:layout_marginEnd="@dimen/generic_margin_4"
        android:layout_marginTop="@dimen/generic_margin_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/alternative_room_label"/>

    <TextView
        android:id="@+id/alternative_room_label"
        style="@style/Subtext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_4"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:gravity="center"
        android:textColor="@color/light_grey_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alternative_room_image_view" />
</androidx.constraintlayout.widget.ConstraintLayout>