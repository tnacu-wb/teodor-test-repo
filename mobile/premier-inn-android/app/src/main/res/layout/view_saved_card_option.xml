<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_24"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cardTypeLabel"
            style="@style/BodySemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="VISA debit (**** 6987)" />

        <com.whitbread.premierinn.common.view.NetworkImageView
            android:id="@+id/cardTypeImage"
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:layout_marginStart="@dimen/generic_margin_8" />


    </LinearLayout>

    <TextView
        android:id="@+id/cardHolderLabel"
        style="@style/Header3Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_8"
        tools:text="Mr Lester Page" />

    <TextView
        android:id="@+id/paymentCardExpiryLabel"
        style="@style/Header3Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginBottom="@dimen/generic_margin_24"
        tools:text="Expires 05/23" />
</LinearLayout>