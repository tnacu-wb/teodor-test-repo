<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:descendantFocusability="beforeDescendants">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_edit_guest_lead_guest_details_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Header3"
                android:layout_marginTop="@dimen/generic_margin_40"
                android:layout_marginStart="@dimen/generic_margin_24"
                android:layout_marginBottom="@dimen/generic_margin_20"
                android:text="@string/lead_guest_details"
                android:textColor="?attr/colorPrimary"/>

            <com.whitbread.premierinn.guestdetails.view.GuestDetailsFormView
                android:id="@+id/gdfv_edit_guest_booker_guest_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/generic_margin_24"
                android:layout_marginEnd="@dimen/generic_margin_24"
                android:layout_marginBottom="@dimen/generic_margin_40"/>

            <com.whitbread.premierinn.guestdetails.adapter.RoomGuestDetailsView
                android:id="@+id/rgdv_edit_guest_rooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/generic_margin_24"
                android:layout_marginEnd="@dimen/generic_margin_24"
                android:paddingBottom="@dimen/generic_padding_60"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grey_light"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/generic_padding_40"
                android:paddingBottom="@dimen/generic_padding_54"
                android:background="@color/metallic_pearl_seventy_percent">

                <com.whitbread.premierinn.common.view.CallToActionButtonLayout
                    android:id="@+id/cab_edit_guest_update_details"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    style="@style/Button1"
                    android:layout_marginStart="@dimen/generic_margin_24"
                    android:layout_marginEnd="@dimen/generic_margin_24"
                    app:cab_background_color="?attr/colorPrimary"
                    app:cab_text_color="@android:color/white"
                    android:text="@string/edit_guest_details_update_details_button"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>