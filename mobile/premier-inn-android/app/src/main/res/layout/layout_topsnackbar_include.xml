<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/snackbar_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Header4"
        android:layout_weight="1"
        android:paddingTop="@dimen/generic_padding_14"
        android:paddingBottom="@dimen/generic_padding_14"
        android:paddingStart="@dimen/generic_padding_12"
        android:paddingEnd="@dimen/generic_padding_12"
        android:textAppearance="@style/TextAppearance.Design.Snackbar.Message"
        android:maxLines="2"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical|start"
        tools:text="Text Goes Here"
        android:textColor="@color/white"
        android:ellipsize="end"/>
    <Button
        android:id="@+id/snackbar_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/BorderlessButton"
        android:layout_marginStart="0dp"
        android:layout_gravity="center_vertical|end"
        android:paddingTop="@dimen/generic_padding_14"
        android:paddingBottom="@dimen/generic_padding_14"
        android:paddingLeft="@dimen/generic_padding_12"
        android:paddingRight="@dimen/generic_padding_12"
        android:visibility="gone"
        android:textColor="?attr/colorAccent"
        tools:visibility="visible"
        tools:text="Action"/>
</merge>