<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/review_booking_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:gravity="center" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scroll_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/generic_padding_44">

                <RelativeLayout
                    android:id="@+id/ll_review_booking_summary_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_12"
                    android:background="@android:color/white"
                    android:elevation="@dimen/generic_elevation_1"
                    android:padding="@dimen/generic_padding_16">

                    <com.whitbread.premierinn.common.view.NetworkImageView
                        android:id="@+id/review_booking_hotel_image"
                        android:layout_width="60dp"
                        android:layout_height="44dp"
                        android:scaleType="fitXY"
                        tools:src="@drawable/landing_page_background" />

                    <TextView
                        android:id="@+id/review_booking_hotel_name_label"
                        style="@style/Header4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/review_booking_hotel_image"
                        android:ellipsize="end"
                        android:lines="1"
                        android:paddingStart="@dimen/generic_padding_16"
                        android:paddingEnd="@dimen/generic_padding_16"
                        android:textColor="?attr/colorPrimary"
                        tools:text="London Heathrow Airport Terminals 4 and 5" />

                    <TextView
                        android:id="@+id/review_booking_dates_guests_rooms_label"
                        style="@style/BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_hotel_name_label"
                        android:layout_toEndOf="@id/review_booking_hotel_image"
                        android:ellipsize="end"
                        android:lines="1"
                        android:paddingStart="@dimen/generic_padding_16"
                        android:paddingTop="@dimen/generic_padding_8"
                        android:paddingEnd="@dimen/generic_padding_16"
                        tools:text="21 Oct  - 25 Oct • 3 guests - 3 rooms" />

                    <ImageView
                        android:id="@+id/iv_review_booking_dashed_separator"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_below="@id/review_booking_hotel_image"
                        android:layout_marginTop="@dimen/generic_margin_14"
                        android:layerType="software"
                        android:src="@drawable/shape_dashed_line_separator" />

                    <TextView
                        android:id="@+id/review_booking_price_label"
                        style="@style/Header2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/iv_review_booking_dashed_separator"
                        android:layout_alignParentEnd="true"
                        android:paddingTop="@dimen/generic_padding_6"
                        tools:text="£180.00" />

                    <TextView
                        style="@style/Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBaseline="@id/review_booking_price_label"
                        android:layout_alignParentStart="true"
                        android:text="@string/review_booking_total_cost" />

                    <TextView
                        android:id="@+id/review_booking_taxes_and_fees"
                        style="@style/BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_price_label"
                        android:layout_alignParentEnd="true"
                        android:gravity="end"
                        android:paddingTop="@dimen/generic_padding_2"
                        android:text="@string/review_booking_taxes_and_fees_message" />

                    <TextView
                        android:id="@+id/review_booking_payment_breakdown_label"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_taxes_and_fees"
                        android:layout_alignParentRight="true"
                        android:gravity="end"
                        android:paddingTop="@dimen/generic_padding_2"
                        android:text="@string/review_booking_payment_breakdown"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="visible"/>

                    <com.whitbread.premierinn.common.view.InfoMessageBoxView
                        android:id="@+id/booking_info_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/review_booking_payment_breakdown_label"
                        android:layout_marginTop="@dimen/generic_margin_8"
                        android:background="@drawable/information_notification_background"
                        android:paddingStart="@dimen/generic_padding_16"
                        android:paddingTop="@dimen/generic_padding_12"
                        android:paddingEnd="@dimen/generic_padding_16"
                        android:paddingBottom="@dimen/generic_padding_12"
                        android:src="@drawable/ic_info"
                        android:visibility="gone"
                        app:iconTintColor="@color/information_blue"
                        tools:visibility="visible" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/review_booking_guest_details_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:elevation="@dimen/generic_elevation_1"
                    android:padding="@dimen/generic_padding_16">

                    <TextView
                        android:id="@+id/review_booking_guest_details_header"
                        style="@style/Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_booking_your_details"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/review_booking_guest_details_edit_button"
                        style="@style/Action1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/review_booking_edit"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/review_booking_guest_details_name_header"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_guest_details_header"
                        android:layout_marginTop="@dimen/generic_margin_16"
                        tools:text="Mr Frodo.bargdg" />

                    <TextView
                        android:id="@+id/review_booking_guest_details_email_header"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_guest_details_name_header"
                        android:layout_marginTop="@dimen/generic_margin_6"
                        tools:text="saffs@sdfds.sdf" />

                    <TextView
                        android:id="@+id/review_booking_guest_details_lead_guest_label"
                        style="@style/Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_guest_details_email_header"
                        android:layout_marginTop="@dimen/generic_margin_30"
                        android:text="@string/lead_guest_details"
                        android:textColor="?attr/colorPrimary" />

                    <com.whitbread.premierinn.reviewbooking.view.LeadGuestDetailsView
                        android:id="@+id/review_booking_guest_details_rooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/review_booking_guest_details_lead_guest_label"
                        android:layout_marginTop="@dimen/generic_margin_22"
                        android:orientation="vertical" />

                </RelativeLayout>

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/business_booker_booking_allowance_infobox"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_16"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:background="@drawable/information_notification_background"
                    android:paddingStart="@dimen/generic_padding_16"
                    android:paddingTop="@dimen/generic_padding_12"
                    android:paddingEnd="@dimen/generic_padding_16"
                    android:paddingBottom="@dimen/generic_padding_12"
                    android:visibility="gone"
                    android:src="@drawable/ic_info"
                    app:iconTintColor="@color/information_blue"
                    tools:text="Your company has approved a meal and/or parking allowance, but this is not included in the total cost."
                    tools:visibility="visible" />

                <RelativeLayout
                    android:id="@+id/review_booking_additional_information_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:background="@android:color/white"
                    android:elevation="@dimen/generic_elevation_1"
                    android:orientation="vertical"
                    android:padding="@dimen/generic_padding_16"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/review_booking_additional_information_header"
                        style="@style/Header3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_booking_additional_information"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/review_booking_additional_information_edit_button"
                        style="@style/Action1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/review_booking_edit"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:id="@+id/review_booking_additional_information_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/review_booking_additional_information_edit_button"
                        android:layout_marginTop="@dimen/generic_margin_16"
                        android:orientation="vertical">

                    </LinearLayout>
                </RelativeLayout>

                <com.whitbread.premierinn.reviewbooking.PaymentComponentView
                    android:id="@+id/payment_component"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_16"
                    android:visibility="visible"
                    tools:visibility="visible"/>

                <com.whitbread.premierinn.reviewbooking.view.DonationView
                    android:id="@+id/review_booking_donation_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <com.whitbread.premierinn.common.view.ExpensesTotalPriceView
                    android:id="@+id/review_booking_expenses_total_price_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:layout_marginEnd="@dimen/generic_margin_16" />

                <TextView
                    android:id="@+id/review_booking_terms_and_conditions_label"
                    style="@style/BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_32"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_32"
                    android:gravity="center" />

                <com.whitbread.premierinn.common.view.CallToActionButtonLayout
                    android:id="@+id/review_booking_confirm_button"
                    style="@style/Button1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_16"
                    android:paddingStart="@dimen/generic_padding_12"
                    android:paddingEnd="@dimen/generic_padding_12"
                    android:text="@string/review_booking_confirm_booking"
                    app:cab_spinner_color="@color/white"
                    app:cab_text_color="@color/white"
                    />

                <RelativeLayout
                    android:id="@+id/review_booking_paypal_button_layout"
                    style="@style/Button1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_16"
                    android:background="@drawable/rounded_background"
                    android:clickable="true"
                    android:gravity="center"
                    android:paddingStart="@dimen/generic_padding_12"
                    android:paddingEnd="@dimen/generic_padding_12"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:cab_spinner_color="@color/white"
                    app:cab_text_color="@color/white">

                    <ProgressBar
                        android:id="@+id/review_booking_paypal_button_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone"/>

                    <ImageView
                        android:id="@+id/review_booking_paypal_button_imageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:visibility="visible"
                        android:gravity="center"
                        android:src="@drawable/paypal_logo" />

                    <TextView
                        android:id="@+id/review_booking_paypal_button_txt_1"
                        style="@style/ButtonPaypal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:layout_marginTop="@dimen/generic_margin_16"
                        android:layout_marginBottom="@dimen/generic_margin_16"
                        android:layout_toStartOf="@id/review_booking_paypal_button_imageView"
                        android:paddingStart="@dimen/generic_padding_6"
                        android:paddingEnd="@dimen/generic_padding_6"
                        android:visibility="visible"
                        android:text="@string/review_booking_paypal_button_label_part1"/>

                    <TextView
                        android:id="@+id/review_booking_paypal_button_txt_2"
                        style="@style/ButtonPaypal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/generic_margin_16"
                        android:layout_marginBottom="@dimen/generic_margin_16"
                        android:layout_marginEnd="@dimen/generic_margin_16"
                        android:layout_toEndOf="@id/review_booking_paypal_button_imageView"
                        android:paddingStart="@dimen/generic_padding_6"
                        android:paddingEnd="@dimen/generic_padding_6"
                        android:visibility="visible"
                        android:text="@string/review_booking_paypal_button_label_part2"/>

                </RelativeLayout>

                <TextView
                    android:id="@+id/review_booking_privacy_policy_label"
                    style="@style/BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_16"
                    android:gravity="center" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/translucent_loading"
        layout="@layout/translucent_loading"
        android:visibility="gone"
        tools:visibility="gone"/>

    <nl.dionsegijn.konfetti.KonfettiView
        android:id="@+id/viewKonfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>