<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@android:color/white"
    android:elevation="@dimen/generic_elevation_2">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/generic_margin_16"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/generic_margin_16"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/review_amend_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/Header4"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginBottom="@dimen/generic_margin_8"
        android:layout_marginEnd="@dimen/generic_margin_4"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/review_amend_room_description"
        app:layout_constraintEnd_toStartOf="@+id/review_amend_price_change"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible"
        tools:text="@string/review_amends_meals_changed"/>

    <TextView
        android:id="@+id/review_amend_room_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/Body"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginBottom="@dimen/generic_margin_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintTop_toBottomOf="@id/review_amend_title"
        tools:visibility="visible"
        tools:text="Premier Inn Breakfast"/>

    <TextView
        android:id="@+id/review_amend_price_change"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/Header4"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginBottom="@dimen/generic_margin_8"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/review_amend_title"
        app:layout_constraintBottom_toBottomOf="@id/review_amend_title"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
        tools:visibility="visible"
        tools:text="+£57.96"/>

</androidx.constraintlayout.widget.ConstraintLayout>