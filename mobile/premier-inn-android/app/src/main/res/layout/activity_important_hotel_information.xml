<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/generic_padding_24">

    <ImageView
        android:id="@+id/iv_important_hotel_info_close_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="end|right"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_cross"
        android:tint="@android:color/black" />

    <TextView
        style="@style/Header1Regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_32"
        android:layout_marginTop="@dimen/generic_margin_24"
        android:text="@string/hotel_details_important_hotel_info_label"
        android:textColor="?attr/colorPrimary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_important_hotel_info_notes_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_40"
        app:layoutManager="LinearLayoutManager" />

</LinearLayout>