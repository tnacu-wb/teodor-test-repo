<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/selectionMenuCloseImageView"
        android:layout_width="@dimen/parking_details_close_image_view_size"
        android:layout_height="@dimen/parking_details_close_image_view_size"
        android:layout_margin="@dimen/generic_margin_16"
        android:background="@drawable/roundel_base"
        android:backgroundTint="@color/grey_88_transparency"
        android:src="@drawable/ic_cross"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/eclipse" />

    <LinearLayout
        android:id="@+id/menusContainerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/generic_margin_16"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectionMenuCloseImageView">

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
