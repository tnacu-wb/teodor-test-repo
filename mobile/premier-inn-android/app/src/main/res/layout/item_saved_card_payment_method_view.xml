<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/genericCardEntryViewRoot"
    android:padding="@dimen/generic_padding_16"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/paymentTypeRadioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        app:buttonTint="@color/teal_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:checked="true" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_8"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/paymentTypeRadioButton"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardTypeLabel"
                style="@style/BodySemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="VISA debit (**** 6987)" />

            <com.whitbread.premierinn.common.view.NetworkImageView
                android:id="@+id/cardTypeImage"
                android:layout_width="32dp"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/generic_margin_8" />


        </LinearLayout>

        <TextView
            android:id="@+id/cardHolderLabel"
            style="@style/Header3Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_8"
            tools:text="Mr Lester Page" />

        <TextView
            android:id="@+id/paymentCardExpiryLabel"
            style="@style/Header3Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_8"
            tools:text="Expires 05/23" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>