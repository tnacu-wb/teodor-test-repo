<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/country_item"
    android:layout_width="match_parent"
    android:layout_height="35dp">

    <TextView
        android:id="@+id/country_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Body"
        android:layout_marginStart="@dimen/generic_margin_4"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:layout_marginBottom="@dimen/generic_margin_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/country_flag_character"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="United Kingdom" />

    <TextView
        android:id="@+id/country_flag_character"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/BodySmall"
        android:layout_marginStart="@dimen/generic_margin_4"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:layout_marginBottom="@dimen/generic_margin_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>