<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:gravity="center" />

    <FrameLayout
        android:id="@+id/payment_methods_page_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <ScrollView
        android:id="@+id/payment_methods_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/generic_padding_16"
                android:background="@color/white"
                android:elevation="@dimen/generic_elevation_1">

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/payment_methods_gdpr_top_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/generic_margin_16"
                    android:background="@drawable/shape_grey_stroke_white_background"
                    android:minLines="3"
                    android:padding="@dimen/generic_padding_16"
                    android:src="@drawable/ic_lock_outline_white"
                    app:iconTintColor="@color/teal" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingTop="@dimen/generic_padding_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/generic_margin_10"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/payment_method_card_number"
                        style="@style/Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/generic_margin_16"
                        android:gravity="center_vertical"
                        tools:text="Ending in 1099" />

                </LinearLayout>

                <TextView
                    android:id="@+id/payment_method_card_holder_name"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_10"
                    tools:text="HDG Cull" />

                <TextView
                    android:id="@+id/payment_method_card_expiry"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginBottom="@dimen/generic_margin_24"
                    tools:text="Expires 10/2019" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:divider="@drawable/shape_divider_grey"
                android:elevation="@dimen/generic_elevation_1"
                android:orientation="vertical"
                android:paddingStart="@dimen/generic_padding_16"
                android:paddingEnd="@dimen/generic_padding_16"
                android:showDividers="beginning|middle">

                <com.whitbread.premierinn.account.view.ListButton
                    android:id="@+id/payment_methods_replace_card"
                    style="@style/ListButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:text="@string/payment_methods_replace_card_item"
                    app:textColor="@color/premier_inn_purple_light" />

                <com.whitbread.premierinn.account.view.ListButton
                    android:id="@+id/payment_methods_delete"
                    style="@style/ListButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:text="@string/payment_methods_delete_card_item"
                    app:textColor="@color/red" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/generic_padding_16">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_info_outline" />

                <TextView
                    android:id="@+id/banner_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_8"
                    android:text="@string/edit_payment_methods_only_one_card_html"
                    style="@style/BodySmall" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>
</LinearLayout>