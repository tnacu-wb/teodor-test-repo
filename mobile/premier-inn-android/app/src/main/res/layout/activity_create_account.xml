<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:minHeight="?attr/actionBarSize"/>

    <ScrollView
        android:id="@+id/create_account_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/create_account_error_message_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="@dimen/generic_padding_16">

                <ImageView
                    android:id="@+id/iv_search_results_ic_info_error"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/error_red"/>

                <TextView
                    android:id="@+id/create_account_error_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Body"
                    android:layout_alignParentTop="true"
                    android:layout_toEndOf="@id/iv_search_results_ic_info_error"
                    android:paddingEnd="0dp"
                    android:paddingStart="@dimen/generic_padding_8"
                    android:textColor="@color/error_red" />

            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="@dimen/generic_elevation_2">

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/create_account_gdpr_top_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/generic_margin_16"
                    android:background="@drawable/shape_grey_stroke_white_background"
                    android:padding="@dimen/generic_padding_16"
                    android:minLines="3"
                    android:src="@drawable/ic_lock_outline_white"
                    app:iconTintColor="@color/teal"/>

            </FrameLayout>

            <com.whitbread.premierinn.common.view.FormInputContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/generic_padding_24"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:elevation="@dimen/generic_elevation_2">

                <include layout="@layout/layout_account_contact_details" />

                <com.whitbread.premierinn.common.view.FormPasswordEditTextView
                    android:id="@+id/create_account_password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:hint="@string/password_label"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/grey_medium"
                    app:editTextId="@+id/create_account_password_edit_text"
                    app:required="true"/>
            </com.whitbread.premierinn.common.view.FormInputContainer>

            <com.whitbread.premierinn.common.view.FormInputContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/generic_padding_24"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:elevation="@dimen/generic_elevation_2">

                <com.whitbread.premierinn.common.view.AddressFormAccountView
                    android:id="@+id/address_form_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </com.whitbread.premierinn.common.view.FormInputContainer>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/generic_padding_24"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:elevation="@dimen/generic_elevation_2">

                <TextView
                    android:id="@+id/create_account_terms_conditions_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/BodySmall"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/create_account_terms_conditions_switch"/>

                <Switch
                    android:id="@+id/create_account_terms_conditions_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:switchPadding="@dimen/generic_padding_40"/>

                <ImageView
                    android:id="@+id/create_account_error_drawable"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_error"
                    android:layout_alignBaseline="@+id/create_account_terms_conditions_error_label"
                    android:layout_alignParentStart="true"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/create_account_terms_conditions_error_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SubtextSmall"
                    android:layout_below="@+id/create_account_terms_conditions_message"
                    android:layout_toEndOf="@+id/create_account_error_drawable"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:text="@string/create_account_terms_conditions_error"
                    android:textColor="@color/error_red"
                    android:visibility="gone"/>

            </RelativeLayout>

            <com.whitbread.premierinn.common.view.CallToActionButtonLayout
                android:id="@+id/create_account_create_account_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                style="@style/Button1"
                android:layout_marginTop="@dimen/generic_margin_40"
                android:layout_marginBottom="@dimen/generic_margin_40"
                android:layout_marginStart="@dimen/generic_margin_24"
                android:layout_marginEnd="@dimen/generic_margin_24"
                android:text="@string/create_account_label"
                app:cab_background_color="?attr/colorAccent"
                app:cab_spinner_color="@color/white"
                app:cab_text_color="@color/white"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>