<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/toolbar_elevation"
        android:minHeight="?attr/actionBarSize" />

    <ScrollView
        android:id="@+id/personal_details_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/personal_details_gdpr_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/generic_margin_16"
                android:background="@color/white"
                android:elevation="@dimen/generic_elevation_2">

                <com.whitbread.premierinn.common.view.InfoMessageBoxView
                    android:id="@+id/personal_details_gdpr_top_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/generic_margin_16"
                    android:background="@drawable/shape_grey_stroke_white_background"
                    android:minLines="3"
                    android:padding="@dimen/generic_padding_16"
                    android:src="@drawable/ic_lock_outline_white"
                    app:iconTintColor="@color/teal" />
            </FrameLayout>

            <com.whitbread.premierinn.common.view.FormInputContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@android:color/white"
                android:elevation="@dimen/generic_elevation_2"
                android:orientation="vertical"
                android:padding="@dimen/generic_padding_24">

                <include layout="@layout/layout_account_contact_details" />

                <TextView
                    style="@style/BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_4"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:text="@string/personal_details_nationality_label"
                    android:textColor="@color/grey_medium" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/personal_details_nationality_dropdown"
                    style="@style/CountySpinnerStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.whitbread.premierinn.common.view.FormEditTextView
                    android:id="@+id/personal_details_passport_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_8"
                    android:hint="@string/personal_details_passport_number_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:visibility="gone"
                    app:editTextId="@+id/personal_details_passport_number_edit_text"
                    app:required="true" />

            </com.whitbread.premierinn.common.view.FormInputContainer>

            <com.whitbread.premierinn.common.view.FormInputContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:elevation="@dimen/generic_elevation_2"
                android:orientation="vertical"
                android:padding="@dimen/generic_padding_24">

                <com.whitbread.premierinn.common.view.AddressFormAccountView
                    android:id="@+id/address_form_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.whitbread.premierinn.common.view.FormInputContainer>

            <com.whitbread.premierinn.common.view.FormInputContainer
                android:id="@+id/personal_details_marketing_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:elevation="@dimen/generic_elevation_2"
                android:orientation="vertical"
                android:padding="@dimen/generic_padding_24">

                <TextView
                    style="@style/Header3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_4"
                    android:text="@string/create_account_email_marketing_label"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_16"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/BodySmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:text="@string/create_account_email_marketing_message" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/personal_details_marketing_toggle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/generic_margin_8"
                        app:showText="false"
                        app:switchMinWidth="60dp"/>
                </LinearLayout>
            </com.whitbread.premierinn.common.view.FormInputContainer>

            <com.whitbread.premierinn.common.view.FormInputContainer
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_16"
                android:background="@android:color/white"
                android:elevation="@dimen/generic_elevation_2"
                android:orientation="vertical"
                android:padding="@dimen/generic_padding_24">

                <TextView
                    android:id="@+id/personal_details_vehicle_details_title"
                    style="@style/Header3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_4"
                    android:layout_marginTop="@dimen/generic_margin_24"
                    android:text="@string/details_vehicle_details_title"
                    android:textColor="?attr/colorPrimary" />

                <com.whitbread.premierinn.common.view.FormEditTextView
                    android:id="@+id/personal_details_car_registration_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/generic_margin_24"
                    android:hint="@string/details_car_registration"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    app:editTextId="@+id/personal_details_car_registration_edit_text" />

            </com.whitbread.premierinn.common.view.FormInputContainer>

            <com.whitbread.premierinn.common.view.CallToActionButtonLayout
                android:id="@+id/personal_details_save_changes_button"
                style="@style/Button1"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/generic_margin_24"
                android:layout_marginTop="@dimen/generic_margin_40"
                android:layout_marginEnd="@dimen/generic_margin_24"
                android:layout_marginBottom="@dimen/generic_margin_40"
                android:text="@string/personal_details_save_changes"
                app:cab_background_color="?attr/colorPrimary"
                app:cab_text_color="@android:color/white"
                app:cab_spinner_color="@color/white"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>