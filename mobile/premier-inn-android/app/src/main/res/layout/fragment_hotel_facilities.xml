<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/generic_padding_16">

    <ImageView
        android:id="@+id/closeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="@dimen/generic_margin_16"
        android:contentDescription="@null"
        android:padding="@dimen/generic_padding_8"
        android:src="@drawable/ic_close_icon_grey" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/Header2Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/generic_margin_24"
        android:text="@string/hotel_details_facilities_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hotelFacilities"
                style="@style/Header3Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/generic_margin_32"
                android:text="@string/hotel_details_facilities_subtitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hotelFacilitiesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/generic_margin_32"
                android:background="@color/grey_medium" />

            <TextView
                android:id="@+id/roomFeatures"
                style="@style/Header3Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_32"
                android:layout_marginBottom="@dimen/generic_margin_24"
                android:text="@string/hotel_details_room_features_subtitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/roomFeaturesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</LinearLayout>