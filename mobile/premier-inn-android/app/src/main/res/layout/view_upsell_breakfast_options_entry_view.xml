<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/generic_padding_16">

    <LinearLayout
        android:id="@+id/upsellDetailsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/upsellSelectionContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleTextView"
            style="@style/Header4SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            tools:text="Meal Deal" />

        <TextView
            android:id="@+id/priceInfoTextView"
            style="@style/BodySmallRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            tools:text="£24.99 per adult/day" />

        <TextView
            android:id="@+id/descriptionTextView"
            style="@style/BodySmallRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/generic_margin_8"
            android:ellipsize="end"
            android:maxLines="4"
            tools:text="Eat as much as you like from our full English and continental buffets" />

    </LinearLayout>

    <TextView
        android:id="@+id/freeBreakfastForKidsTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:background="@drawable/blue_rounded_background"
        android:paddingHorizontal="@dimen/generic_padding_8"
        android:paddingVertical="@dimen/generic_padding_4"
        android:text="@string/upsells_kids_eat_breakfast_free"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/upsellSelectionContainer"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/upsellDetailsContainer"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/upsellSelectionContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/upsell_selection_container_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/upsellDetailsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/upsellDetailsContainer">

        <ImageView
            android:id="@+id/minusImageView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:paddingVertical="@dimen/generic_padding_8"
            android:paddingStart="@dimen/generic_padding_12"
            android:src="@drawable/ic_minus"
            app:tint="@color/medium_black"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/numberOfSelectionsTextView"
            style="@style/Header2Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/generic_margin_8"
            android:textColor="@color/medium_black"
            tools:text="0" />

        <ImageView
            android:id="@+id/plusImageView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:paddingVertical="@dimen/generic_padding_8"
            android:paddingEnd="@dimen/generic_padding_12"
            android:src="@drawable/ic_plus"
            app:tint="@color/medium_black"
            tools:ignore="RtlSymmetry" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>