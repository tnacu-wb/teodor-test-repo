<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_item_height"
    android:gravity="bottom"
    android:background="@drawable/item_search_header_bg"
    android:orientation="horizontal"
    android:paddingStart="@dimen/generic_padding_24"
    android:paddingEnd="@dimen/generic_padding_24"
    android:paddingBottom="@dimen/generic_padding_10">

    <TextView
        android:id="@+id/tv_search_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/grey_dark"
        style="@style/Header4"
        tools:text="Recent searches" />

    <TextView
        android:id="@+id/tv_search_header_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_activity_clear"
        android:textColor="@color/premier_inn_purple"
        style="@style/Action1" />
</LinearLayout>