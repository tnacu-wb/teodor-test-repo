<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/generalInfoContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/generic_margin_16"
    android:layout_marginTop="@dimen/generic_margin_24"
    android:layout_marginEnd="@dimen/generic_margin_16"
    android:layout_marginBottom="@dimen/generic_margin_16"
    android:background="@drawable/booking_pre_stay_details_card_shape"
    android:padding="@dimen/generic_padding_16"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <com.whitbread.premierinn.common.view.ShapeableNetworkImageView
        android:id="@+id/hotelImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CornerRounded8" />

    <TextView
        android:id="@+id/hotelTitle"
        style="@style/Header2ExtraBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/generic_margin_16"
        android:ellipsize="end"
        android:lineSpacingExtra="0sp"
        android:maxLines="2"
        android:textColor="@color/full_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/hotelImage"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="London Holborn" />

    <TextView
        android:id="@+id/hotelStayDate"
        style="@style/Header4Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_4"
        android:textColor="@color/grey_dark"
        app:layout_constraintStart_toEndOf="@id/hotelImage"
        app:layout_constraintTop_toBottomOf="@id/hotelTitle"
        tools:text="Fri 15 Sept - Sun 18 Sept" />

    <TextView
        android:id="@+id/hotelStayInfo"
        style="@style/BodySmallSemiBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/generic_margin_16"
        android:layout_marginTop="@dimen/generic_margin_4"
        android:textColor="@color/grey_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/hotelImage"
        app:layout_constraintTop_toBottomOf="@id/hotelStayDate"
        tools:text="2 adults, 1 child" />

</androidx.constraintlayout.widget.ConstraintLayout>