<?xml version="1.0" encoding="utf-8"?>
<!-- Please keep dimens in px for absolute value. Don't want dimens to be scaled to device pixel density
 This layout will not be displayed in the app, but is used for generating an A4 scale pdf document
 -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/guest_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="10px"
        tools:text="Guest 1"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/guest_first_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="10px"
        tools:text="First name: "/>

    <TextView
        android:id="@+id/guest_last_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="10px"
        tools:text="Last name: "/>

    <TextView
        android:id="@+id/guest_date_of_birth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="10px"
        tools:text="Date of birth: "/>

    <TextView
        android:id="@+id/guest_nationality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="10px"
        tools:text="Nationality: "
        android:layout_marginBottom="8px"/>
</LinearLayout>
