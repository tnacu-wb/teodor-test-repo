<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_important_hotel_room_substitution_info_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/generic_margin_16"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:background="@drawable/shape_grey_stroke_white_background"
        android:orientation="vertical"
        android:padding="@dimen/generic_padding_16">

        <ImageView
            android:id="@+id/iv_important_hotel_info_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_info"
            android:tint="?colorPrimary" />

        <TextView
            android:id="@+id/room_substitution_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Body"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_2"
            android:layout_toEndOf="@+id/iv_important_hotel_info_icon"
            android:text="@string/hotel_details_room_substitution_main" />

    </RelativeLayout>
</FrameLayout>