<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:clipToPadding="false"
        android:elevation="@dimen/generic_elevation_8">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/generic_margin_16"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:layout_marginEnd="@dimen/generic_margin_16"
            android:layout_marginBottom="@dimen/generic_margin_8"
            app:cardCornerRadius="@dimen/generic_corner_radius_2"
            app:cardElevation="@dimen/generic_elevation_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_postcode_finder_back_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/generic_margin_16"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="false"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="?attr/colorPrimary" />

                <EditText
                    android:id="@+id/et_postcode_finder_search_input"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:gravity="center_vertical"
                    android:hint="@string/postcode_finder_search_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <com.whitbread.premierinn.common.view.PrivacyPolicyBannerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/postcode_view_error_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginTop="@dimen/generic_margin_70"
            android:src="@drawable/ic_postcode_error" />

        <TextView
            style="@style/Header3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_16"
            android:text="@string/postcode_finder_error_no_address" />

        <TextView
            android:id="@+id/postcode_error_label_manual_address"
            style="@style/Header3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_30"
            android:background="?attr/selectableItemBackground"
            android:text="@string/address_form_enter_address_manual"
            android:textColor="?attr/colorPrimary" />

        <TextView
            style="@style/BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:text="@string/postcode_finder_error_different_postcode"
            android:textColor="@color/grey" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/ll_postcode_finder_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/generic_margin_30"
                android:layout_marginBottom="@dimen/generic_margin_8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_search_top"
                    style="@style/Header3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_16"
                    android:layout_weight="1"
                    android:text="@string/postcode_finder_find_address_label" />

                <TextView
                    android:id="@+id/postcode_label_manual_address"
                    style="@style/Action1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/generic_margin_16"
                    android:layout_marginEnd="@dimen/generic_margin_16"
                    android:layout_weight="2"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="end"
                    android:text="@string/address_form_enter_address_manual"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_postcode_finder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/generic_margin_16"
                android:layout_marginEnd="@dimen/generic_margin_16"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_adress_finder_list" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/full_address_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/pb_address_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</LinearLayout>