<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/amend_meals_and_extra_card"
    style="@style/CardView.CardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPaddingBottom="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.whitbread.premierinn.common.view.InfoMessageBoxView
            android:id="@+id/upsells_changed_warning_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/alert_notification_background"
            android:padding="@dimen/generic_padding_16"
            android:layout_marginBottom="@dimen/action1_text_size_16"
            android:src="@drawable/notifications_alert"
            android:text="@string/amend_upsells_removed_message"
            android:visibility="gone"
            app:alignTextCenter="false"
            app:iconTintColor="@color/gamboge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/amend_meals_and_extra_heading"/>

        <TextView
            android:id="@+id/amend_meals_and_extra_heading"
            style="@style/Header2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/generic_margin_16"
            android:text="@string/amend_meals_and_extras"
            app:layout_constraintBottom_toTopOf="@id/separator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <View
            android:id="@+id/separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/shape_divider_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/change_meals_and_extras" />

        <com.whitbread.premierinn.account.view.ListButton
            android:id="@+id/change_meals_and_extras"
            style="@style/ListButton.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:text="@string/amend_change_meals"
            app:textColor="?colorPrimary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>