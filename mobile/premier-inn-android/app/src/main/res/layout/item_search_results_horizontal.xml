<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/search_results_horizontal_item_height"
    android:layout_marginBottom="@dimen/generic_margin_16"
    android:background="@color/white"
    android:elevation="@dimen/toolbar_elevation"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="@dimen/generic_padding_6">

    <com.whitbread.premierinn.common.view.NetworkImageView
        android:id="@+id/search_result_hotel_image"
        style="@style/Header4"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:layout_marginStart="@dimen/generic_margin_8"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:foreground="@color/grey_semi_transparent"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/search_result_hotel_name"
        style="@style/Header4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_2"
        android:layout_marginBottom="@dimen/generic_margin_4"
        app:layout_constraintBottom_toTopOf="@+id/search_result_distance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Edinburgh City Centre Edinburgh City Centre" />

    <TextView
        android:id="@+id/search_result_distance"
        style="@style/SubtextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/search_result_parking_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/search_result_hotel_name"
        tools:text="5.2 miles from your location" />

    <TextView
        android:id="@+id/search_result_parking_description"
        style="@style/SubtextSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/generic_margin_4"
        android:drawableStart="@drawable/test"
        android:drawablePadding="@dimen/generic_padding_4"
        android:drawableTint="@color/premier_inn_purple"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/search_result_distance"
        tools:text="Chargeable parking " />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="116dp" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/generic_margin_8"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_result_hotel_image" />

    <com.whitbread.premierinn.common.view.NetworkImageView
        android:id="@+id/search_results_trip_advisor_image"
        android:layout_width="83dp"
        android:layout_height="20dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/search_result_hotel_image"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/pricesFrom"
        style="@style/Subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prices_from"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toBottomOf="@+id/divider" />

    <TextView
        android:id="@+id/search_result_price"
        style="@style/Header2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_8"
        android:layout_marginEnd="@dimen/generic_margin_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/anchor"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/pricesFrom"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        tools:text="£1002.00" />

    <ImageView
        android:id="@+id/anchor"
        android:layout_width="20dp"
        android:layout_height="37dp"
        android:background="@color/teal"
        android:src="@drawable/ic_calendar_right"
        android:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/search_results_fully_booked_label"
        style="@style/Header3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_white_background_rounded_corner"
        android:padding="@dimen/generic_padding_6"
        android:text="@string/search_results_fully_booked"
        app:layout_constraintBottom_toBottomOf="@+id/search_result_hotel_image"
        app:layout_constraintEnd_toEndOf="@+id/search_result_hotel_image"
        app:layout_constraintStart_toStartOf="@+id/search_result_hotel_image"
        app:layout_constraintTop_toTopOf="@+id/search_result_hotel_image" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/generic_margin_8" />
</androidx.constraintlayout.widget.ConstraintLayout>