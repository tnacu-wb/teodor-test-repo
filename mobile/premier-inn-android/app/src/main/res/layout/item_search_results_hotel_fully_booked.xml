<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/generic_corner_radius_2">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/generic_padding_16">

        <com.whitbread.premierinn.common.view.NetworkImageView
            android:id="@+id/search_result_hotel_image"
            android:layout_width="110dp"
            android:layout_height="80dp"
            android:layout_marginStart="@dimen/generic_margin_8"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:layout_marginEnd="@dimen/generic_margin_8"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/call_to_action_button_background" />

        <TextView
            android:id="@+id/search_results_fully_booked_label"
            style="@style/BodySemiBold"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="@dimen/generic_margin_8"
            android:background="@drawable/shape_white_background_rounded_corner"
            android:paddingStart="@dimen/generic_padding_16"
            android:paddingTop="@dimen/generic_padding_8"
            android:paddingEnd="@dimen/generic_padding_16"
            android:paddingBottom="@dimen/generic_padding_8"
            android:textColor="@color/grey"
            app:layout_constraintBottom_toBottomOf="@+id/search_result_hotel_image"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintLeft_toLeftOf="@+id/search_result_hotel_image"
            app:layout_constraintRight_toRightOf="@+id/search_result_hotel_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/search_result_hotel_image"
            tools:text="@string/search_results_fully_booked" />

        <TextView
            android:id="@+id/search_result_hotel_name"
            style="@style/Header4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/generic_margin_8"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:layout_marginBottom="@dimen/generic_margin_8"
            android:maxLines="2"
            android:textColor="@color/grey_dark"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="@+id/guideline"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="London Kings Cross St. Pancreas" />


        <TextView
            android:id="@+id/callToActionButtonLayout"
            style="@style/BookingDetailsButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/generic_margin_8"
            android:layout_marginTop="@dimen/generic_margin_16"
            android:layout_marginEnd="@dimen/generic_margin_8"
            android:layout_marginBottom="@dimen/generic_margin_8"
            android:paddingStart="@dimen/generic_padding_16"
            android:paddingEnd="@dimen/generic_padding_16"
            android:text="@string/search_results_edit_date"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guideline"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/search_result_hotel_name"
            tools:text="@string/search_results_edit_date"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>