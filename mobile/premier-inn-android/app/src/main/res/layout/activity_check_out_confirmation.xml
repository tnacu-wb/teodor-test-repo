<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premier_inn_purple">

    <TextView
        android:id="@+id/checkedOutTitle"
        style="@style/Header2ExtraBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="0sp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="@dimen/generic_padding_32"
        android:text="@string/checkout_confirmation_title"
        android:textSize="@dimen/largeTitle_text_size_35"
        android:textColor="@color/metallic_pearl_seventy_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/checkedOutMessage"/>

    <TextView
        android:id="@+id/checkedOutMessage"
        style="@style/Header2ExtraBold"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="0sp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="@dimen/generic_padding_40"
        android:layout_marginHorizontal="@dimen/generic_padding_32"
        android:text="@string/checkout_confirmation_message"
        android:textSize="@dimen/header2_text_size_17"
        android:textColor="@color/metallic_pearl_seventy_percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.whitbread.premierinn.common.view.CallToActionButtonLayout
        android:id="@+id/doneButton"
        style="@style/Button1"
        android:layout_width="326dp"
        android:layout_height="50dp"
        android:text="@string/done"
        app:cab_background_color="@color/white"
        app:cab_spinner_color="@color/white"
        app:cab_text_color="@color/grey_dark"
        android:layout_marginBottom="120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
