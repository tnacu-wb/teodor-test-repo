<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/amend_dates_card"
    style="@style/CardView.CardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:contentPaddingBottom="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/amend_room_number_heading"
                style="@style/Header2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/teal"
                tools:text="Room 1" />

            <TextView
                android:id="@+id/amend_remove_room"
                style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/amend_remove_room"
                android:textColor="@color/razzmatazz" />
        </LinearLayout>

        <TextView
            android:id="@+id/amend_room_lead_guest_title"
            style="@style/Header4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_16"
            tools:text="Lead Guest: Mr John Smith" />

        <TextView
            android:id="@+id/amend_room_criteria"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_2"
            android:layout_marginBottom="@dimen/generic_margin_16"
            tools:text="2 Adults, Twin room" />

        <TextView
            android:id="@+id/amend_room_meals_title"
            style="@style/Header4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/amend_meals"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/amend_room_meals"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/generic_margin_16"
            android:visibility="gone"
            tools:text="Premier Inn Breakfast (2 guests)"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/amend_room_extras_title"
            style="@style/Header4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/summary_breakdown_extras_heading"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/amend_room_extras"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/generic_margin_16"
            android:visibility="gone"
            tools:text="Ultimate Wi-Fi"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/shape_divider_grey" />

        <com.whitbread.premierinn.account.view.ListButton
            android:id="@+id/edit_room"
            style="@style/ListButton.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:text="@string/amend_change_room"
            app:textColor="?colorPrimary" />
    </LinearLayout>

</androidx.cardview.widget.CardView>