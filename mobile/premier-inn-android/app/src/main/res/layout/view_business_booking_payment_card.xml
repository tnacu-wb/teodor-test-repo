<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="@dimen/generic_corner_radius_4"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/generic_margin_24">

        <TextView
            android:id="@+id/paymentCardType"
            style="@style/BodyBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Business Acc. Card" />

        <TextView
            android:id="@+id/paymentCardNumber"
            style="@style/BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentCardType"
            tools:text="Ending in 9381" />

        <TextView
            android:id="@+id/paymentCardName"
            style="@style/BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentCardNumber"
            tools:text="Mr HDG Cull" />

        <TextView
            android:id="@+id/paymentCardExpiryDate"
            style="@style/BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentCardName"
            tools:text="Expires 10/19" />

        <TextView
            android:id="@+id/paymentCardLabel"
            style="@style/BodySmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_10"
            android:background="@drawable/bb_label_payment_card_background"
            android:paddingStart="@dimen/generic_padding_12"
            android:paddingTop="@dimen/generic_padding_4"
            android:paddingEnd="@dimen/generic_padding_12"
            android:paddingBottom="@dimen/generic_padding_4"
            tools:text="@string/business_booker_account_card"
            android:textColor="@color/white"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentCardExpiryDate" />

        <com.whitbread.premierinn.common.view.InfoMessageBoxView
            android:id="@+id/paymentCardNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/generic_margin_8"
            android:background="@drawable/alert_notification_background"
            android:src="@drawable/ic_info"
            app:iconTintColor="@color/alert_orange"
            android:padding="@dimen/generic_padding_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/paymentCardLabel"
            android:visibility="visible"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>