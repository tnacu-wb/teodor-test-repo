<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:background="@drawable/shape_grey_stroke_white_background">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|start"
        android:layout_marginEnd="@dimen/generic_margin_8"
        android:scaleType="fitXY"
        android:visibility="gone"
        tools:src="@drawable/ic_lock_outline_white"
        tools:tint="@color/red"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BodySmall"
        tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. \nLorem Ipsum has been the industry's standard dummy text ever since the 1500s, when a nunknown printer took a galley of type and scrambled it to make a type specimen book."
        tools:textColor="?attr/urgentHighlightColor" />

</merge>