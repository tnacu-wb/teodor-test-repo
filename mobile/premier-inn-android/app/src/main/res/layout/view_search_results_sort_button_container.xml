<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/white"
    android:gravity="center"
    android:paddingStart="@dimen/generic_padding_16"
    android:paddingTop="@dimen/generic_padding_8"
    android:paddingEnd="@dimen/generic_padding_16"
    android:paddingBottom="@dimen/generic_padding_8">

    <com.whitbread.premierinn.common.view.ToggleButtonView
        android:id="@+id/availabilitySortToggle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_margin="0dp"
        android:layout_weight="1"
        app:tbv_start_selected="true"
        app:tbv_text_left="@string/search_results_toggle_button_left"
        app:tbv_text_right="@string/search_results_toggle_button_right" />

    <Button
        android:id="@+id/mapBtn"
        style="@style/ButtonBorderGrey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/generic_margin_16"
        android:text="@string/search_results_map_view" />
</LinearLayout>