<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Font type based on Font weight

        <400 Light
        400	Normal
        500	Medium
        600	Semi Bold (Demi Bold)
        700	Bold
        >700 Extra Bold
    -->

