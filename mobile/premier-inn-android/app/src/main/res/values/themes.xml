<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/premier_inn_purple</item>
        <item name="colorPrimaryDark">@color/premier_inn_purple_dark</item>
        <item name="colorAccent">@color/teal_dark</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/metallic_pearl_seventy_percent</item>
        <item name="android:colorControlHighlight" >@color/premier_inn_purple_twenty_five_percent</item>
        <item name="android:textColor">@color/grey_dark</item>
        <item name="android:textColorHint">@color/grey_medium</item>
        <item name="android:editTextColor">@color/grey_dark</item>
        <item name="editTextColor">@color/grey_dark</item>
        <item name="colorControlNormal">@color/mint_dark_fifty_percent</item>
        <item name="android:textColorLink">@color/premier_inn_purple_light</item>
        <item name="defaultBackgroundColor">@android:color/white</item>

        <item name="dividerColor">@color/metallic_pearl</item>
        <item name="dividerHardColor">@color/grey_light_x</item>
        <item name="disabledColorItem">@color/premier_inn_purple_twenty_five_percent</item>
        <item name="disabledColorButtonPicture">@color/mint_dark</item>
        <item name="searchViewTitleColor">@color/grey</item>

        <item name="infoViewBackgroundColor">@color/red_five_percent</item>
        <item name="infoViewBorderColor">@color/red</item>
        <item name="colorControlActivated">@color/premier_inn_purple_light</item>

        <item name="urgentHighlightColor">@color/red</item>

        <item name="internetOfflineBackgroundMessage">@color/red</item>
        <item name="internetOnlineBackgroundMessage">@color/teal_light</item>
        <item name="internetOfflineOnlineTextColor">@android:color/white</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="actionButtonStyle">@style/ActionButtonStyle</item>

        <item name="passwordErrorColor">@color/new_error_red</item>
        <item name="passwordAcceptedColor">@color/success_green</item>
    </style>

    <style name="AppTheme.Dialog" parent="Theme.AppCompat.DayNight.Dialog"/>

    <style name="ToolbarThemeOverlay" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:fontFamily">@font/proxima_nova_semibold</item>
    </style>

    <style name="ActionButtonStyle" parent="@style/Widget.AppCompat.ActionButton">
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="PurpleDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/Header2</item>
        <item name="android:buttonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton">
        <item name="android:textColor">@color/purple_heart</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/proxima_nova_semibold</item>
    </style>

    <style name="TransparentButton">
        <item name="android:textColor">@color/purple_heart</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@null</item>
        <item name="fontFamily">@font/proxima_nova_semibold</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="EditButtonStyle" parent="Body">
        <item name="textAllCaps">false</item>
        <item name="android:background">@drawable/edit_button_background</item>
        <item name="android:textColor">@color/grey_dark</item>
        <item name="android:paddingStart">@dimen/generic_padding_12</item>
        <item name="android:paddingEnd">@dimen/generic_padding_12</item>
    </style>

    <style name="AppTheme.Dialog.Custom">
        <item name="colorPrimary">@color/premier_inn_purple</item>
        <item name="colorPrimaryDark">@color/premier_inn_purple_dark</item>
        <item name="colorAccent">@color/yellow</item>
        <item name="android:colorControlHighlight" >@color/premier_inn_purple_twenty_five_percent</item>
        <item name="android:textColor">@color/grey_dark</item>
        <item name="android:textColorHint">@color/grey_medium</item>
        <item name="mcv_selectionColor">@color/mint_dark_fifty_percent</item>
        <item name="disabledColorItem">@color/premier_inn_purple_twenty_five_percent</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:padding">0dp</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>

    <style name="AppTheme.NoActionBar.Purple">
        <item name="android:windowBackground">@color/premier_inn_purple</item>
        <item name="navigationIcon">@drawable/ic_arrow_back_white</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="AppTheme.NoActionBar.White" parent="AppTheme.NoActionBar">
        <item name="toolbarStyle">@style/WhiteToolbar</item>
        <item name="android:textColorPrimary">@color/grey_dark</item>
        <item name="navigationIcon">@drawable/ic_arrow_back_purple</item>
    </style>

    <style name="WhiteToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/white</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="AppTheme.FullScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:colorControlHighlight" >@color/premier_inn_purple_twenty_five_percent</item>
    </style>

    <style name="AppTheme.FullScreen.Purple">
        <item name="android:windowBackground">@drawable/landing_window_purple_background</item>
        <item name="android:indeterminateTint">@color/white</item>
    </style>

    <style name="AppTheme.Purple" parent="AppTheme">
        <item name="android:windowBackground">@color/premier_inn_purple</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppTheme.NoActionBar.MapFullScreen">
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="AppTheme.HotelDetails">
        <item name="android:statusBarColor">@color/premier_inn_purple</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="AppTheme.CheckInOnline">
        <item name="android:windowDrawsSystemBarBackgrounds" >true</item>
        <item name="android:statusBarColor" >@color/premier_inn_purple</item>
    </style>

    <style name="AppTheme.CheckOutConfirmation">
        <item name="android:windowDrawsSystemBarBackgrounds" >true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/premier_inn_purple</item>
        <item name="android:statusBarColor" >@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar.SlideTransitionActivity">
        <item name="android:windowAnimationStyle">@style/Animation.SlideUpAnimation</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="Toolbar.TitleWhite" parent="BodySemiBold">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Toolbar.SubTitleSmallWhite" parent="BodySmall">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Toolbar.TitleTextSmall" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="Toolbar.SubTitleTextSmall" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

</resources>