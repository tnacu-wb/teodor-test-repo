{
  "name": "oracle-ohip-opera-cloud-update",
  "version": "2.0.0",
  "description": "Next.js app to update Opera Cloud via OHIP APIs",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
