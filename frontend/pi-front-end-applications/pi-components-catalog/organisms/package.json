{
  "name": "@whitbread-eos/organisms",
  "version": "1.0.0",
  "description": "PremierInn organisms folder",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "watch": "babel --watch --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "build": "rm -rf dist && tsc --emitDeclarationOnly --declarationDir './dist' && babel --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "build:dev": "babel --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "lint": "eslint src -f table --color --quiet",
    "lint:fix": "eslint src -f table --color --fix --quiet",
    "test": "jest --verbose",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' jest --ci --silent --coverage --bail --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=3072' jest --coverage --maxWorkers=50%",
    "test:coverage:open": "open coverage/lcov-report/index.html",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.17.5",
    "@chakra-ui/icons": "2.1.1",
    "@chakra-ui/react": "2.8.2",
    "@googlemaps/jest-mocks": "^2.7.4",
    "@googlemaps/js-api-loader": "^1.14.3",
    "@testing-library/dom": "8.17.1",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "15.0.7",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/google.maps": "^3.49.1",
    "@types/react": "19.0.8",
    "jest": "29.7.0",
    "jest-axe": "^6.0.0",
    "jest-dom": "^4.0.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "webpack": "5.104.1",
    "typescript": "5.5.3",
    "webpack-cli": "~4.9.2"
  },
  "peerDependencies": {
    "@choc-ui/chakra-autocomplete": "5.2.9",
    "@emotion/react": "^11",
    "@emotion/styled": "^11.11.0",
    "classnames": "^2.3.1",
    "date-fns": "^4.1.0",
    "framer-motion": "6.2.8",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "i18next-http-backend": "^3.0.5",
    "next": "15.5.24",
    "next-i18next": "^10.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.49.2"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@auth0/nextjs-auth0": "^4.18.0",
    "@whitbread-eos/api": "^1.0.0",
    "@whitbread-eos/atoms": "^1.0.0",
    "@whitbread-eos/molecules": "^1.0.0",
    "@whitbread-eos/utils": "^1.0.0",
    "yup": "^0.32.11"
  },
  "exports": {
    ".": "./dist/index.js",
    "./restaurants": {
      "types": "./dist/restaurants/index.d.ts",
      "default": "./dist/restaurants/index.js"
    }
  }
}
