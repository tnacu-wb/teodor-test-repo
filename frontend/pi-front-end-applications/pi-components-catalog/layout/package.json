{
  "name": "@whitbread-eos/layout",
  "version": "1.0.0",
  "description": "Layout components",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "private": true,
  "scripts": {
    "watch": "swc src -d dist --watch --extensions \".tsx,.ts,.js,.jsx\"",
    "build": "rm -rf dist && tsc --emitDeclarationOnly --declarationDir './dist' && swc src -d dist --extensions \".tsx,.ts,.js,.jsx\"",
    "build:dev": "swc src -d dist --extensions \".tsx,.ts,.js,.jsx\"",
    "lint": "eslint src -f table --color --quiet",
    "lint:fix": "eslint src -f table --color --fix --quiet",
    "test": "jest --verbose",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' jest --ci --silent --coverage --bail --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=3072' jest --coverage --maxWorkers=50%",
    "test:coverage:open": "open coverage/lcov-report/index.html",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.5.7",
    "@swc/jest": "^0.2.36",
    "@testing-library/dom": "8.17.1",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^15.0.7",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-axe": "^6.0.0",
    "jest-dom": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.5.3"
  },
  "peerDependencies": {},
  "dependencies": {
    "@whitbread-eos/atoms": "^1.0.0"
  }
}
