{
  "name": "@whitbread-eos/atoms",
  "version": "1.0.0",
  "description": "Chakra UI wrapper library",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "predev": "yarn svg2react-component",
    "watch": "babel --watch --copy-files --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "prebuild": "yarn svg2react-component",
    "build": "rm -rf dist && tsc --emitDeclarationOnly --declarationDir './dist' && babel --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\" && cp -r src/theme/design-tokens dist/theme/",
    "build:dev": "babel --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\" && cp -r src/theme/design-tokens dist/theme/",
    "build:storybook:css": "tailwindcss -c ./tailwind.storybook.config.js -i ../../apps/next-apps/business-booker/src/app/global.css -o .storybook/shadcn-storybook.css",
    "prestorybook": "yarn build:storybook:css",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "yarn build:storybook:css",
    "build-storybook": "storybook build",
    "lint": "eslint src -f table --color --quiet",
    "lint:fix": "eslint src -f table --color --fix --quiet",
    "test": "jest --verbose",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' jest --ci --silent --coverage --bail --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=3072' jest --coverage --maxWorkers=50%",
    "test:coverage:open": "open coverage/lcov-report/index.html",
    "svg2react-component": "svgr --no-prettier --replace-attr-values '#58595B={props.color || \"#58595B\"}','#00798E={props.color || \"#00798E\"}','#007FAB={props.color || \"#007FAB\"}','#D73D00={props.color || \"#D73D00\"}','#333={props.color || \"#333\"}','#D90941={props.color || \"#D90941\"}','#FC0F42={props.color || \"#FC0F42\"}','#1C8754={props.color || \"#1C8754\"}','#000={props.color || \"#000\"}'  --typescript --out-dir src/assets/icons -- assets",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.17.5",
    "@babel/plugin-transform-runtime": "^7.17.0",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/react-webpack5": "^10.4.3",
    "@chakra-ui/icons": "2.1.1",
    "@chakra-ui/react": "2.8.2",
    "@choc-ui/chakra-autocomplete": "5.2.9",
    "@emotion/react": "^11",
    "@emotion/styled": "^11.11.0",
    "@googlemaps/jest-mocks": "^2.7.4",
    "@svgr/cli": "^6.2.1",
    "@svgr/webpack": "^6.2.1",
    "@testing-library/dom": "8.17.1",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "15.0.7",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/google.maps": "^3.49.1",
    "@types/jest": "^27.4.1",
    "@types/jest-axe": "^3.5.4",
    "@types/pluralize": "^0.0.29",
    "@types/react": "19.0.8",
    "@types/react-slick": "^0.23.8",
    "babel-jest": "^30.2.0",
    "babel-loader": "^8.2.5",
    "classnames": "^2.3.1",
    "clean-webpack-plugin": "^4.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "6.2.8",
    "jest": "29.7.0",
    "jest-axe": "^6.0.0",
    "jest-dom": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^10.4.3",
    "typescript": "5.5.3",
    "webpack": "5.104.1",
    "webpack-cli": "^4.9.2"
  },
  "peerDependencies": {
    "@chakra-ui/icons": "2.1.1",
    "@chakra-ui/react": "2.8.2",
    "@choc-ui/chakra-autocomplete": "5.2.9",
    "@emotion/react": "^11",
    "@emotion/styled": "^11.11.0",
    "classnames": "^2.3.1",
    "date-fns": "^4.1.0",
    "framer-motion": "6.2.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4",
    "@choc-ui/chakra-autocomplete": "5.2.9",
    "@googlemaps/js-api-loader": "^1.14.3",
    "@hookform/resolvers": "^2.9.6",
    "@paypal/react-paypal-js": "^8.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tanstack/react-table": "^8.19.2",
    "@whitbread-eos/api": "^1.0.0",
    "@whitbread-eos/utils": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "downshift": "^9.3.1",
    "lucide-react": "^0.554.0",
    "nanoid": "^6.0.1",
    "next": "15.5.24",
    "next-i18next": "^10.2.0",
    "pluralize": "^8.0.0",
    "react-datepicker": "9.1.0",
    "react-day-picker": "^8.10.1",
    "react-hook-form": "^7.49.2",
    "react-infinite-scroll-component": "^6.1.0",
    "react-nanny": "^2.14.1",
    "react-select": "^5.8.0",
    "react-slick": "^0.31.0",
    "recharts": "^2.15.1",
    "shadcn-ui": "0.9.5",
    "vaul": "^1.1.1",
    "yup": "^0.32.11"
  },
  "deployment": {
    "helmChart": "./atoms/"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ui": "./dist/components/ui/index.js",
    "./restaurants": {
      "types": "./dist/components/restaurants/index.d.ts",
      "default": "./dist/components/restaurants/index.js"
    }
  }
}
