{
  "name": "@whitbread-eos/api",
  "version": "1.0.0",
  "description": "PremierInn API package",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "watch": "babel --watch --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "build": "rm -rf dist && tsc --emitDeclarationOnly --declarationDir './dist' && babel --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "build:dev": "babel --config-file ./babel.config.js src --out-dir ./dist --extensions \".tsx,.ts,.js,.jsx\"",
    "lint": "concurrently --names oxlint,eslint \"oxlint src --quiet\" \"eslint src -f table --color --quiet\"",
    "lint:eslint": "eslint src -f table --color --quiet",
    "lint:fix": "oxlint src --fix && eslint src -f table --color --fix --quiet",
    "lint:oxlint": "oxlint src --quiet",
    "test": "jest --verbose",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' jest --ci --silent --coverage --bail --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=3072' jest --coverage --maxWorkers=50%",
    "test:coverage:open": "open coverage/lcov-report/index.html",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "7.28.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.17.5",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "15.0.7",
    "@types/react": "19.0.8",
    "concurrently": "^9.0.0",
    "jest": "29.7.0",
    "oxlint": "^1.71.0",
    "typescript": "5.5.3",
    "webpack": "5.104.1",
    "webpack-cli": "~4.9.2"
  },
  "peerDependencies": {
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0"
  }
}
