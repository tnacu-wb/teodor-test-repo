NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Payment Orchestrator base URL (server-side API routes only)
NEXT_PUBLIC_PAYMENT_ORCHESTRATION_API="http://localhost:9200"

# Datatrans Secure Fields JS library URL
# Sandbox: https://pay.sandbox.datatrans.com/upp/payment/js/secure-fields-2.0.0.min.js
# Production: https://pay.datatrans.com/upp/payment/js/secure-fields-2.0.0.min.js
NEXT_PUBLIC_DATATRANS_SECURE_FIELDS_URL="https://pay.sandbox.datatrans.com/upp/payment/js/secure-fields-2.0.0.min.js"

# Datatrans PayPal Button JS library URL
# Sandbox: https://pay.sandbox.datatrans.com/upp/payment/js/paypal-button-1.0.0.js
# Production: https://pay.datatrans.com/upp/payment/js/paypal-button-1.0.0.js
NEXT_PUBLIC_DATATRANS_PAYPAL_BUTTON_URL="https://pay.sandbox.datatrans.com/upp/payment/js/paypal-button-1.0.0.js"

# Datatrans Payment Button JS library URL (Apple Pay / Google Pay)
# Sandbox: https://pay.sandbox.datatrans.com/upp/payment/js/payment-button-3.0.0.js
# Production: https://pay.datatrans.com/upp/payment/js/payment-button-3.0.0.js
NEXT_PUBLIC_DATATRANS_PAYMENT_BUTTON_URL="https://pay.sandbox.datatrans.com/upp/payment/js/payment-button-3.0.0.js"

# Datatrans Merchant ID (provided by Datatrans for your account)
NEXT_PUBLIC_DATATRANS_MERCHANT_ID=""

# Google Pay Merchant ID (from Google Pay Business Console, required for production)
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=""