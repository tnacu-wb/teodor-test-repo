{
  "name": "business-booker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_APOLLO_CLIENT_VERSION=$(node -p 'require(\"./package.json\").version') next dev",
    "build": "NEXT_PUBLIC_APOLLO_CLIENT_VERSION=$(node -p 'require(\"./package.json\").version') NODE_OPTIONS='--max-old-space-size=8192' next build --no-lint",
    "debug": "NODE_OPTIONS='--inspect' next dev",
    "start": "next start",
    "lint": "eslint src -f table --color --quiet",
    "lint:fix": "eslint src -f table --color --fix --quiet",
    "test": "jest --verbose",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=12288' jest --ci --silent --coverage --bail --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=3072' jest --coverage --maxWorkers=50%",
    "test:coverage:open": "open coverage/lcov-report/index.html",
    "type-check": "tsc --noEmit",
    "check-integrity": "yarn type-check && yarn lint:fix && yarn test && yarn build",
    "automation": "yarn --cwd playwright playwright test ",
    "automation:ui": "yarn --cwd playwright playwright test --ui",
    "automation:report": "yarn --cwd playwright playwright show-report"
  },
  "dependencies": {
    "@chakra-ui/icons": "2.1.1",
    "@chakra-ui/react": "2.8.2",
    "@emotion/react": "^11",
    "@emotion/styled": "^11.11.0",
    "@googlemaps/js-api-loader": "^1.14.3",
    "@hookform/resolvers": "^3.3.1",
    "@paypal/react-paypal-js": "^8.1.3",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/user-event": "^14.2.0",
    "@types/cookies": "^0.7.7",
    "@types/smoothscroll-polyfill": "^0.3.1",
    "@types/uuid": "^8.3.4",
    "@whitbread-eos/api": "^1.0.0",
    "@whitbread-eos/atoms": "^1.0.0",
    "@whitbread-eos/layout": "^1.0.0",
    "@whitbread-eos/molecules": "^1.0.0",
    "@whitbread-eos/organisms": "^1.0.0",
    "@whitbread-eos/utils": "^1.0.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cookies": "^0.8.0",
    "date-fns": "^4.1.0",
    "framer-motion": "6.2.8",
    "graphiql": "1.11.5",
    "graphiql-explorer": "^0.9.0",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "graphql-ws": "^5.14.0",
    "i18next-http-backend": "^3.0.5",
    "immer": "^9.0.12",
    "isomorphic-unfetch": "^3.1.0",
    "jwt-decode": "^3.1.2",
    "libphonenumber-js": "^1.11.18",
    "lodash.debounce": "^4.0.8",
    "next": "15.5.24",
    "next-i18next": "^15.2.0",
    "picocolors": "^1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.49.2",
    "react-phone-number-input": "^3.2.11",
    "sharp": "^0.35.4",
    "smoothscroll-polyfill": "^0.4.4",
    "tailwind-merge": "^2.3.0",
