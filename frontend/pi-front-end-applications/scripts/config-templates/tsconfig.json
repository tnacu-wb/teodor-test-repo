{
    "compilerOptions": {
      "lib": ["dom", "dom.iterable", "esnext"],
      "module": "esnext",
      "skipLibCheck": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "jsx": "preserve",
      "sourceMap": true,
      "outDir": "dist",
      "declaration": true,
      "incremental": false
    },
    "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"],
    "include": ["src/**/*"]
  }
  