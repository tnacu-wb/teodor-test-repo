    "lerna/nx/axios": "^1.18.0",
    "lerna/nx/yaml": "^2.8.3",
    "lerna/minimatch/brace-expansion": "^1.1.18",
    "glob/minimatch/brace-expansion": "^1.1.18",
    "eslint-plugin-import/minimatch/brace-expansion": "^1.1.18",
    "eslint-plugin-react/minimatch/brace-expansion": "^1.1.18",
    "eslint/minimatch/brace-expansion": "^1.1.18",
