{
  "name": "pi-front-end-applications",
  "description": "Whitbread Premier Inn Front End Applications Mono Repo",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "private": true,
  "//": [
    "checkov:skip=axe-core[BC_LIC_3]: axe-core is used only by accessibility test and lint tooling; MPL-2.0 is permitted by the repository dependency policy"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "start:pi": "lerna run dev --scope=premier-inn",
    "start:ccui": "lerna run dev --scope=ccui",
    "start:bb": "lerna run dev --scope=business-booker",
    "build": "lerna run build",
    "build:pi": "lerna run build --scope=premier-inn",
    "build:ccui": "lerna run build --scope=ccui",
    "build:bb": "lerna run build --scope=business-booker",
    "build:all": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && yarn && yarn type-generate --local && yarn build:atomic:components",
    "lint": "lerna run lint",
    "lint:fix": "lerna run lint:fix",
    "test": "cross-env SKIP_PREFLIGHT_CHECK=true lerna run test --load-env-files=false",
    "test:coverage": "cross-env SKIP_PREFLIGHT_CHECK=true lerna run test:coverage --load-env-files=false",
    "test:ci": "cross-env SKIP_PREFLIGHT_CHECK=true lerna run test:ci --load-env-files=false",
    "prepare": "",
    "commit": "cz",
    "type-check": "lerna run type-check",
    "type-check:all": "lerna run type-check",
    "check-integrity:all": "lerna run check-integrity",
    "watch:atomic:components": "lerna watch --scope=@whitbread-eos/* -- lerna run build:dev --scope=\\$LERNA_PACKAGE_NAME",
    "build:atomic:components": "lerna run build --scope=@whitbread-eos/* --include-dependencies",
    "test:atomic:components": "lerna run test --scope=@whitbread-eos/*",
    "type-generate": "graphql-codegen --config codegen.ts",
    "clean:packages": "find . -name 'node_modules'  -type d -prune -exec rm -rf {} +",
    "clean:packages:complete": "yarn run clean:packages && find . -name 'yarn.lock' -type f -prune -exec rm {} +",
    "automation": "lerna run automation",
    "automation:ui": "lerna run automation:ui",
    "automation:report": "lerna run automation:report"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.18.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-use-effect-event": "0.0.2",
    "@types/superagent": "^8.1.9",
    "chance": "^1.1.12",
    "cross-env": "^10.1.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.6.1",
    "pretty-quick": "^3.1.3",
    "superagent": "^10.1.1",
    "swr": "^2.2.5",
    "unleash-client": "6.11.1",
    "uuid": "^14.0.0",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.20.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@graphql-codegen/cli": "6.0.1",
    "@graphql-codegen/client-preset": "5.1.0",
    "@graphql-codegen/typescript": "5.0.2",
    "@graphql-codegen/typescript-document-nodes": "5.0.2",
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@types/chance": "^1.1.6",
    "@types/minimatch": "3",
    "babel-plugin-transform-dynamic-import": "^2.1.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "^16.3.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "9.1.2",
    "eslint-formatter-table": "7.32.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsonc": "2.21.1",
    "eslint-plugin-oxlint": "^1.71.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fast-check": "^4.9.0",
    "globals": "15.15.0",
    "husky": "^7.0.0",
    "jest-next-dynamic": "^1.0.1",
    "lerna": "^9.0.0",
    "lint-staged": "^12.3.4",
    "prettier": "3.8.3",
    "typescript-eslint": "8.60.1"
  },
  "workspaces": [
    "apps/next-apps/*",
    "pi-components-catalog/*",
    "pi-components-catalog/pages/*"
