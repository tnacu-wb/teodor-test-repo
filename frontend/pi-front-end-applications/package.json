    "sharp": "^0.35.4"
  },
  "lint-staged": {
    "apps/**/src/**/*.{js,ts,jsx,tsx}": [
      "yarn pretty-quick --staged",
      "yarn eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "nohoist": [
    "**/webpack",
    "**/webpack-cli",
    "**/ts-loader",
    "**/ts-loader/**"
  ]
