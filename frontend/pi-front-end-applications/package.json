    "flatted": "3.4.2",
    "undici": "^6.28.0",
    "protobufjs": "^7.6.5",
    "handlebars": "^4.7.9",
    "immutable": "^4.3.9",
    "tar": "^7.5.22",
    "playwright": "^1.55.1",
    "lodash-es": "^4.18.0",
    "svgo": "^2.8.1",
    "follow-redirects": "^1.16.0",
    "dompurify": "^3.4.13",
    "qs": "6.16.0",
    "webpack": "^5.104.1",
    "tmp": "^0.2.7",
    "i18next-fs-backend": "^2.6.4",
    "i18next-http-backend": "^3.0.5",
    "lerna/minimatch": "^3.1.5",
    "eslint-plugin-react/minimatch": "^3.1.5",
    "glob/minimatch": "^3.1.5",
    "test-exclude/minimatch": "^3.1.5",
    "eslint-plugin-import/minimatch": "^3.1.5",
    "eslint/minimatch": "^3.1.5",
    "@humanwhocodes/config-array/minimatch": "^3.1.5",
    "@eslint/eslintrc/minimatch": "^3.1.5",
    "eslint-plugin-jsx-a11y/minimatch": "^3.1.5",
    "eslint-config-next/minimatch": "^3.1.5",
    "@svgr/cli/minimatch": "^5.1.9",
    "@swc/cli/minimatch": "^9.0.9",
    "unleash-client/minimatch": "^9.0.9",
