{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@config": ["config/index.ts"],
      "@pages/*": ["src/pages/*"],
      "@pages": ["src/pages/pi/index.ts"],
      "@components/*": ["src/components/*"],
      "@components": ["src/components/pi/index.ts"],
      "@fixtures/*": ["src/fixtures/*"],
      "@fixtures": ["src/fixtures/base.fixture.ts"],
      "@api/*": ["src/api/*"],
      "@api": ["src/api/index.ts"],
      "@test-data/*": ["src/test-data/*"],
      "@test-data": ["src/test-data/index.ts"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils/index.ts"]
    }
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "reference"]
}
