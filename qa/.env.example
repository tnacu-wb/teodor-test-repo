# ─── QA Secrets Template ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
# Setup:
#   cp .env.example .env
#   # Fill in your credentials below

# Legacy HTTP auth password used for CCUI secure URL authorization.
OLD_AUTH_PASSWORD=

# ─── Basic Auth (Akamai WAF) ─────────────────────────────────────────────────
HTTP_AUTH_USERNAME=betatester
HTTP_AUTH_PASSWORD=
EXECUTION_ENV=local
ENV=uat
APP=pi
LOCALE=gb-en

# ─── OHIP Configuration (Oracle Hospitality Integration Platform) ─────────────
# OHIP API is UAT for both DIT and UAT test environments.
# These credentials are used regardless of whether you're testing DIT or UAT.
#
OHIP_CLIENT_ID=
OHIP_CLIENT_SECRET=
OHIP_X_API_KEY=

# ─── Payment Webhook Configuration ───────────────────────────────────────────
PAYMENT_WEBHOOK_X_WHIT_API_KEY=

# ─── LambdaTest (required only for EXECUTION_ENV=lambdatest) ─────────────────
LT_USERNAME=
LT_ACCESS_KEY=
