# 2000ms = 2 seconds
READ_CONNECTION_TIMEOUT=20000
INTROSPECTION=true

#Option are console, dynatrace, none
ENABLE_OPEN_TELEMETRY=none
#Delay in ms before exporting spans
SCHEDULED_DELAY_MILLIS=5000
#Max spans to keep in the buffer
MAX_QUEUE_SIZE=2048
#Max spans to export in a single batch
MAX_EXPORT_BATCH_SIZE=512
#Timeout for sending a batch in ms
EXPORT_TIMEOUT_MILLIS=30000

DYNATRACE_URL: 'http://localhost:4318/v1/traces'
DYNATRACE_TOKEN: 'YOUR_DYNATRACE_API_TOKEN'
