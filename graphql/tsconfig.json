{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "es2023",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "noUnusedParameters": false
  },
  "include": ["**/*.ts", "**/*.graphql", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}